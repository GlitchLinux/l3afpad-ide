<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-codecourse-contrast" name="Codecourse Contrast" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Codecourse Contrast (rainglow)</description>

    <style name="text" foreground="#b6ced8" background="#05080a"/>
    <style name="selection" background="#1ea8fc"/>
    <style name="cursor" foreground="#ffffff"/>
    <style name="current-line" background="#0a1014"/>
    <style name="line-numbers" foreground="#b6ced8" background="#05080a"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#456b7c"/>
    <style name="def:string" foreground="#cccccc"/>
    <style name="def:keyword" foreground="#1ea8fc"/>
    <style name="def:statement" foreground="#5dcdfd"/>
    <style name="def:type" foreground="#1ea8fc"/>
    <style name="def:function" foreground="#ffffff"/>
    <style name="def:decimal" foreground="#aaaaaa"/>
    <style name="def:floating-point" foreground="#aaaaaa"/>
    <style name="def:base-n-integer" foreground="#aaaaaa"/>
    <style name="def:special-constant" foreground="#5dcdfd"/>
    <style name="def:constant" foreground="#aaaaaa"/>
    <style name="def:preprocessor" foreground="#6494a9"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
