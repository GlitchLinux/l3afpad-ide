<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-joker-light" _name="Joker Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Joker Light (rainglow)</_description>

    <style name="text" foreground="#4a5159" background="#ffffff"/>
    <style name="selection" background="#00b27d"/>
    <style name="cursor" foreground="#333333"/>
    <style name="current-line" background="#ffffff"/>
    <style name="line-numbers" foreground="#4a5159" background="#ffffff"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#acb5bf"/>
    <style name="def:string" foreground="#76818e"/>
    <style name="def:keyword" foreground="#00b27d"/>
    <style name="def:statement" foreground="#9a6fc4"/>
    <style name="def:type" foreground="#00b27d"/>
    <style name="def:function" foreground="#4a5159"/>
    <style name="def:decimal" foreground="#aaaaaa"/>
    <style name="def:floating-point" foreground="#aaaaaa"/>
    <style name="def:base-n-integer" foreground="#aaaaaa"/>
    <style name="def:special-constant" foreground="#9a6fc4"/>
    <style name="def:constant" foreground="#aaaaaa"/>
    <style name="def:preprocessor" foreground="#d7dbe0"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
