<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-storm" _name="Storm" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Storm (rainglow)</_description>

    <style name="text" foreground="#bacedd" background="#092327"/>
    <style name="selection" background="#00a9a5"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#0c2e33"/>
    <style name="line-numbers" foreground="#bacedd" background="#092327"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#145059"/>
    <style name="def:string" foreground="#fdb825"/>
    <style name="def:keyword" foreground="#126d6b"/>
    <style name="def:statement" foreground="#00a9a5"/>
    <style name="def:type" foreground="#126d6b"/>
    <style name="def:function" foreground="#4e8098"/>
    <style name="def:decimal" foreground="#fd9825"/>
    <style name="def:floating-point" foreground="#fd9825"/>
    <style name="def:base-n-integer" foreground="#fd9825"/>
    <style name="def:special-constant" foreground="#00a9a5"/>
    <style name="def:constant" foreground="#fd9825"/>
    <style name="def:preprocessor" foreground="#228897"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
