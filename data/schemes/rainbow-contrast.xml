<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-rainbow-contrast" _name="Rainbow Contrast" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Rainbow Contrast (rainglow)</_description>

    <style name="text" foreground="#c7d0d9" background="#16181a"/>
    <style name="selection" background="#b3cc57"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#1d2022"/>
    <style name="line-numbers" foreground="#c7d0d9" background="#16181a"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#424c55"/>
    <style name="def:string" foreground="#c78feb"/>
    <style name="def:keyword" foreground="#3fb4c5"/>
    <style name="def:statement" foreground="#ef746f"/>
    <style name="def:type" foreground="#b3cc57"/>
    <style name="def:function" foreground="#ffbe40"/>
    <style name="def:decimal" foreground="#c78feb"/>
    <style name="def:floating-point" foreground="#c78feb"/>
    <style name="def:base-n-integer" foreground="#c78feb"/>
    <style name="def:special-constant" foreground="#ef746f"/>
    <style name="def:constant" foreground="#c78feb"/>
    <style name="def:preprocessor" foreground="#637280"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
