<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-frontier-contrast" name="Frontier Contrast" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Frontier Contrast (rainglow)</description>

    <style name="text" foreground="#f8f8f2" background="#110f0e"/>
    <style name="selection" background="#2ebf7e"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#191615"/>
    <style name="line-numbers" foreground="#f8f8f2" background="#110f0e"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#7a7267"/>
    <style name="def:string" foreground="#f8bb39"/>
    <style name="def:keyword" foreground="#fc803d"/>
    <style name="def:statement" foreground="#f23a3a"/>
    <style name="def:type" foreground="#2ebf7e"/>
    <style name="def:function" foreground="#f8bb39"/>
    <style name="def:decimal" foreground="#2ebf7e"/>
    <style name="def:floating-point" foreground="#2ebf7e"/>
    <style name="def:base-n-integer" foreground="#2ebf7e"/>
    <style name="def:special-constant" foreground="#f23a3a"/>
    <style name="def:constant" foreground="#2ebf7e"/>
    <style name="def:preprocessor" foreground="#a0988e"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
