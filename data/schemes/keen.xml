<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-keen" name="Keen" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Keen (rainglow)</description>

    <style name="text" foreground="#cccccc" background="#111111"/>
    <style name="selection" background="#8767b7"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#191919"/>
    <style name="line-numbers" foreground="#cccccc" background="#111111"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#374c60"/>
    <style name="def:string" foreground="#b5db99"/>
    <style name="def:keyword" foreground="#6f8b94"/>
    <style name="def:statement" foreground="#8767b7"/>
    <style name="def:type" foreground="#6f8b94"/>
    <style name="def:function" foreground="#b5db99"/>
    <style name="def:decimal" foreground="#b5db99"/>
    <style name="def:floating-point" foreground="#b5db99"/>
    <style name="def:base-n-integer" foreground="#b5db99"/>
    <style name="def:special-constant" foreground="#8767b7"/>
    <style name="def:constant" foreground="#b5db99"/>
    <style name="def:preprocessor" foreground="#537291"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
