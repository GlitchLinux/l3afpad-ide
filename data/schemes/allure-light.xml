<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-allure-light" name="Allure Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Allure Light (rainglow)</description>

    <style name="text" foreground="#555e68" background="#ffffff"/>
    <style name="selection" background="#5da892"/>
    <style name="cursor" foreground="#333333"/>
    <style name="current-line" background="#ffffff"/>
    <style name="line-numbers" foreground="#555e68" background="#ffffff"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#b5c0cc"/>
    <style name="def:string" foreground="#cec86f"/>
    <style name="def:keyword" foreground="#5da892"/>
    <style name="def:statement" foreground="#e4d294"/>
    <style name="def:type" foreground="#5da892"/>
    <style name="def:function" foreground="#555e68"/>
    <style name="def:decimal" foreground="#cea36f"/>
    <style name="def:floating-point" foreground="#cea36f"/>
    <style name="def:base-n-integer" foreground="#cea36f"/>
    <style name="def:special-constant" foreground="#e4d294"/>
    <style name="def:constant" foreground="#cea36f"/>
    <style name="def:preprocessor" foreground="#e2e7eb"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
