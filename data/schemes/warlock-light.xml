<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-warlock-light" _name="Warlock Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Warlock Light (rainglow)</_description>

    <style name="text" foreground="#4b4060" background="#ffffff"/>
    <style name="selection" background="#725ac1"/>
    <style name="cursor" foreground="#222222"/>
    <style name="current-line" background="#ffffff"/>
    <style name="line-numbers" foreground="#4b4060" background="#ffffff"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#aaaaaa"/>
    <style name="def:string" foreground="#f78362"/>
    <style name="def:keyword" foreground="#b67ae8"/>
    <style name="def:statement" foreground="#7eb1dd"/>
    <style name="def:type" foreground="#f46036"/>
    <style name="def:function" foreground="#7c86d6"/>
    <style name="def:decimal" foreground="#f7a261"/>
    <style name="def:floating-point" foreground="#f7a261"/>
    <style name="def:base-n-integer" foreground="#f7a261"/>
    <style name="def:special-constant" foreground="#7eb1dd"/>
    <style name="def:constant" foreground="#f7a261"/>
    <style name="def:preprocessor" foreground="#d0d0d0"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
