<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-revelation" name="Revelation" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Revelation (rainglow)</description>

    <style name="text" foreground="#dedede" background="#2e2c2b"/>
    <style name="selection" background="#617fa0"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#363432"/>
    <style name="line-numbers" foreground="#dedede" background="#2e2c2b"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#7b726b"/>
    <style name="def:string" foreground="#ffbb29"/>
    <style name="def:keyword" foreground="#c2dcf2"/>
    <style name="def:statement" foreground="#617fa0"/>
    <style name="def:type" foreground="#4e5d84"/>
    <style name="def:function" foreground="#95c2e8"/>
    <style name="def:decimal" foreground="#617fa0"/>
    <style name="def:floating-point" foreground="#617fa0"/>
    <style name="def:base-n-integer" foreground="#617fa0"/>
    <style name="def:special-constant" foreground="#617fa0"/>
    <style name="def:constant" foreground="#617fa0"/>
    <style name="def:preprocessor" foreground="#a09892"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
