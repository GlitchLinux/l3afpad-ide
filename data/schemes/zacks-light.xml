<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-zacks-light" name="Zacks Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Zacks Light (rainglow)</description>

    <style name="text" foreground="#444444" background="#ffffff"/>
    <style name="selection" background="#9c7ddb"/>
    <style name="cursor" foreground="#222222"/>
    <style name="current-line" background="#ffffff"/>
    <style name="line-numbers" foreground="#444444" background="#ffffff"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#aaaaaa"/>
    <style name="def:string" foreground="#bcd42a"/>
    <style name="def:keyword" foreground="#ff6a38"/>
    <style name="def:statement" foreground="#ff6a38"/>
    <style name="def:type" foreground="#9c7ddb"/>
    <style name="def:function" foreground="#bcd42a"/>
    <style name="def:decimal" foreground="#bcd42a"/>
    <style name="def:floating-point" foreground="#bcd42a"/>
    <style name="def:base-n-integer" foreground="#bcd42a"/>
    <style name="def:special-constant" foreground="#ff6a38"/>
    <style name="def:constant" foreground="#bcd42a"/>
    <style name="def:preprocessor" foreground="#d0d0d0"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
