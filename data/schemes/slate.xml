<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-slate" name="Slate" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Slate (rainglow)</description>

    <style name="text" foreground="#ebebf4" background="#3d3d4c"/>
    <style name="selection" background="#566981"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#444454"/>
    <style name="line-numbers" foreground="#ebebf4" background="#3d3d4c"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#6c6c87"/>
    <style name="def:string" foreground="#9eb2d9"/>
    <style name="def:keyword" foreground="#566981"/>
    <style name="def:statement" foreground="#89a7b1"/>
    <style name="def:type" foreground="#566981"/>
    <style name="def:function" foreground="#cbdad5"/>
    <style name="def:decimal" foreground="#9eb2d9"/>
    <style name="def:floating-point" foreground="#9eb2d9"/>
    <style name="def:base-n-integer" foreground="#9eb2d9"/>
    <style name="def:special-constant" foreground="#89a7b1"/>
    <style name="def:constant" foreground="#9eb2d9"/>
    <style name="def:preprocessor" foreground="#9595aa"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
