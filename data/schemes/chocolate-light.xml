<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-chocolate-light" name="Chocolate Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Chocolate Light (rainglow)</description>

    <style name="text" foreground="#150f08" background="#ffffff"/>
    <style name="selection" background="#8b6e46"/>
    <style name="cursor" foreground="#222222"/>
    <style name="current-line" background="#ffffff"/>
    <style name="line-numbers" foreground="#150f08" background="#ffffff"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#e2cdb0"/>
    <style name="def:string" foreground="#f7a21b"/>
    <style name="def:keyword" foreground="#8e744f"/>
    <style name="def:statement" foreground="#a08f76"/>
    <style name="def:type" foreground="#5b472c"/>
    <style name="def:function" foreground="#b5a48d"/>
    <style name="def:decimal" foreground="#f7a21b"/>
    <style name="def:floating-point" foreground="#f7a21b"/>
    <style name="def:base-n-integer" foreground="#f7a21b"/>
    <style name="def:special-constant" foreground="#a08f76"/>
    <style name="def:constant" foreground="#f7a21b"/>
    <style name="def:preprocessor" foreground="#f7f0e8"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
