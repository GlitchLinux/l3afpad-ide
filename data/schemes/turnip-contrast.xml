<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-turnip-contrast" _name="Turnip Contrast" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Turnip Contrast (rainglow)</_description>

    <style name="text" foreground="#ede0ce" background="#080809"/>
    <style name="selection" background="#487d76"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#0f0f11"/>
    <style name="line-numbers" foreground="#ede0ce" background="#080809"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#7a7267"/>
    <style name="def:string" foreground="#e8da5e"/>
    <style name="def:keyword" foreground="#92b55f"/>
    <style name="def:statement" foreground="#487d76"/>
    <style name="def:type" foreground="#92b55f"/>
    <style name="def:function" foreground="#e8da5e"/>
    <style name="def:decimal" foreground="#e8da5e"/>
    <style name="def:floating-point" foreground="#e8da5e"/>
    <style name="def:base-n-integer" foreground="#e8da5e"/>
    <style name="def:special-constant" foreground="#487d76"/>
    <style name="def:constant" foreground="#e8da5e"/>
    <style name="def:preprocessor" foreground="#a0988e"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
