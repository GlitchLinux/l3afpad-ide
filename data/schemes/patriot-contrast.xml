<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-patriot-contrast" _name="Patriot Contrast" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Patriot Contrast (rainglow)</_description>

    <style name="text" foreground="#cad9e3" background="#0d0e0f"/>
    <style name="selection" background="#de333c"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#141617"/>
    <style name="line-numbers" foreground="#cad9e3" background="#0d0e0f"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#515e66"/>
    <style name="def:string" foreground="#3790de"/>
    <style name="def:keyword" foreground="#bbbcc4"/>
    <style name="def:statement" foreground="#2e6fd9"/>
    <style name="def:type" foreground="#de333c"/>
    <style name="def:function" foreground="#ffffff"/>
    <style name="def:decimal" foreground="#2e6fd9"/>
    <style name="def:floating-point" foreground="#2e6fd9"/>
    <style name="def:base-n-integer" foreground="#2e6fd9"/>
    <style name="def:special-constant" foreground="#2e6fd9"/>
    <style name="def:constant" foreground="#2e6fd9"/>
    <style name="def:preprocessor" foreground="#738590"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
