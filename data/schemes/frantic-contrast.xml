<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-frantic-contrast" _name="Frantic Contrast" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Frantic Contrast (rainglow)</_description>

    <style name="text" foreground="#aeb9c4" background="#0e1114"/>
    <style name="selection" background="#ef6462"/>
    <style name="cursor" foreground="#ffffff"/>
    <style name="current-line" background="#14191d"/>
    <style name="line-numbers" foreground="#aeb9c4" background="#0e1114"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#44515e"/>
    <style name="def:string" foreground="#afa9e5"/>
    <style name="def:keyword" foreground="#ef6462"/>
    <style name="def:statement" foreground="#89a7bc"/>
    <style name="def:type" foreground="#ef6462"/>
    <style name="def:function" foreground="#e6eaef"/>
    <style name="def:decimal" foreground="#968cea"/>
    <style name="def:floating-point" foreground="#968cea"/>
    <style name="def:base-n-integer" foreground="#968cea"/>
    <style name="def:special-constant" foreground="#89a7bc"/>
    <style name="def:constant" foreground="#968cea"/>
    <style name="def:preprocessor" foreground="#64778a"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
