<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-tweed-light" name="Tweed Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Tweed Light (rainglow)</description>

    <style name="text" foreground="#585e6d" background="#ffffff"/>
    <style name="selection" background="#d3643b"/>
    <style name="cursor" foreground="#333333"/>
    <style name="current-line" background="#ffffff"/>
    <style name="line-numbers" foreground="#585e6d" background="#ffffff"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#c7cee0"/>
    <style name="def:string" foreground="#e7a84b"/>
    <style name="def:keyword" foreground="#e2975f"/>
    <style name="def:statement" foreground="#5e9989"/>
    <style name="def:type" foreground="#585e6d"/>
    <style name="def:function" foreground="#cab696"/>
    <style name="def:decimal" foreground="#e7a84b"/>
    <style name="def:floating-point" foreground="#e7a84b"/>
    <style name="def:base-n-integer" foreground="#e7a84b"/>
    <style name="def:special-constant" foreground="#5e9989"/>
    <style name="def:constant" foreground="#e7a84b"/>
    <style name="def:preprocessor" foreground="#f8f9fb"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
