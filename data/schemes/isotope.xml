<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-isotope" name="Isotope" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Isotope (rainglow)</description>

    <style name="text" foreground="#f3eff5" background="#454955"/>
    <style name="selection" background="#b3dd49"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#4c505d"/>
    <style name="line-numbers" foreground="#f3eff5" background="#454955"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#7b85a0"/>
    <style name="def:string" foreground="#86baba"/>
    <style name="def:keyword" foreground="#b3dd49"/>
    <style name="def:statement" foreground="#b3dd49"/>
    <style name="def:type" foreground="#72b01d"/>
    <style name="def:function" foreground="#ffffff"/>
    <style name="def:decimal" foreground="#afd1d1"/>
    <style name="def:floating-point" foreground="#afd1d1"/>
    <style name="def:base-n-integer" foreground="#afd1d1"/>
    <style name="def:special-constant" foreground="#b3dd49"/>
    <style name="def:constant" foreground="#afd1d1"/>
    <style name="def:preprocessor" foreground="#a7aec0"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
