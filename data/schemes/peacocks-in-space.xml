<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-peacocks-in-space" _name="Peacocks In Space" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Peacocks In Space (rainglow)</_description>

    <style name="text" foreground="#dee3ec" background="#2b303b"/>
    <style name="selection" background="#26a6a6"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#313744"/>
    <style name="line-numbers" foreground="#dee3ec" background="#2b303b"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#6e7a94"/>
    <style name="def:string" foreground="#bcd42a"/>
    <style name="def:keyword" foreground="#26a6a6"/>
    <style name="def:statement" foreground="#ff5d38"/>
    <style name="def:type" foreground="#26a6a6"/>
    <style name="def:function" foreground="#bcd42a"/>
    <style name="def:decimal" foreground="#bcd42a"/>
    <style name="def:floating-point" foreground="#bcd42a"/>
    <style name="def:base-n-integer" foreground="#bcd42a"/>
    <style name="def:special-constant" foreground="#ff5d38"/>
    <style name="def:constant" foreground="#bcd42a"/>
    <style name="def:preprocessor" foreground="#9aa2b4"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
