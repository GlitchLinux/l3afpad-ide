<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-box-uk-light" _name="Box UK Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Box UK Light (rainglow)</_description>

    <style name="text" foreground="#414f5c" background="#ffffff"/>
    <style name="selection" background="#017c9d"/>
    <style name="cursor" foreground="#222222"/>
    <style name="current-line" background="#ffffff"/>
    <style name="line-numbers" foreground="#414f5c" background="#ffffff"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#b8b6b1"/>
    <style name="def:string" foreground="#15b8ae"/>
    <style name="def:keyword" foreground="#017c9d"/>
    <style name="def:statement" foreground="#019d76"/>
    <style name="def:type" foreground="#017c9d"/>
    <style name="def:function" foreground="#15b8ae"/>
    <style name="def:decimal" foreground="#15b8ae"/>
    <style name="def:floating-point" foreground="#15b8ae"/>
    <style name="def:base-n-integer" foreground="#15b8ae"/>
    <style name="def:special-constant" foreground="#019d76"/>
    <style name="def:constant" foreground="#15b8ae"/>
    <style name="def:preprocessor" foreground="#dcdbd9"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
