<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-rainbow-light" name="Rainbow Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Rainbow Light (rainglow)</description>

    <style name="text" foreground="#444444" background="#ffffff"/>
    <style name="selection" background="#b3cc57"/>
    <style name="cursor" foreground="#222222"/>
    <style name="current-line" background="#ffffff"/>
    <style name="line-numbers" foreground="#444444" background="#ffffff"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#aaaaaa"/>
    <style name="def:string" foreground="#c78feb"/>
    <style name="def:keyword" foreground="#3fb4c5"/>
    <style name="def:statement" foreground="#ef746f"/>
    <style name="def:type" foreground="#b3cc57"/>
    <style name="def:function" foreground="#ffbe40"/>
    <style name="def:decimal" foreground="#c78feb"/>
    <style name="def:floating-point" foreground="#c78feb"/>
    <style name="def:base-n-integer" foreground="#c78feb"/>
    <style name="def:special-constant" foreground="#ef746f"/>
    <style name="def:constant" foreground="#c78feb"/>
    <style name="def:preprocessor" foreground="#d0d0d0"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
