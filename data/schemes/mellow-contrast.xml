<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-mellow-contrast" _name="Mellow Contrast" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Mellow Contrast (rainglow)</_description>

    <style name="text" foreground="#f8f8f2" background="#0b0a09"/>
    <style name="selection" background="#f55d79"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#131210"/>
    <style name="line-numbers" foreground="#f8f8f2" background="#0b0a09"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#7a7267"/>
    <style name="def:string" foreground="#f8bb39"/>
    <style name="def:keyword" foreground="#f2bc79"/>
    <style name="def:statement" foreground="#1f8181"/>
    <style name="def:type" foreground="#f2bc79"/>
    <style name="def:function" foreground="#f28972"/>
    <style name="def:decimal" foreground="#f8bb39"/>
    <style name="def:floating-point" foreground="#f8bb39"/>
    <style name="def:base-n-integer" foreground="#f8bb39"/>
    <style name="def:special-constant" foreground="#1f8181"/>
    <style name="def:constant" foreground="#f8bb39"/>
    <style name="def:preprocessor" foreground="#a0988e"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
