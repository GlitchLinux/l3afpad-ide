<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-pastel" name="Pastel" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Pastel (rainglow)</description>

    <style name="text" foreground="#eeeeee" background="#222222"/>
    <style name="selection" background="#008d62"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#2a2a2a"/>
    <style name="line-numbers" foreground="#eeeeee" background="#222222"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#444444"/>
    <style name="def:string" foreground="#c56c6c"/>
    <style name="def:keyword" foreground="#c5906c"/>
    <style name="def:statement" foreground="#04c4a5"/>
    <style name="def:type" foreground="#9474a9"/>
    <style name="def:function" foreground="#c56c6c"/>
    <style name="def:decimal" foreground="#c56c6c"/>
    <style name="def:floating-point" foreground="#c56c6c"/>
    <style name="def:base-n-integer" foreground="#c56c6c"/>
    <style name="def:special-constant" foreground="#04c4a5"/>
    <style name="def:constant" foreground="#c56c6c"/>
    <style name="def:preprocessor" foreground="#6a6a6a"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
