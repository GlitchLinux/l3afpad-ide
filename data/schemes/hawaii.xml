<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-hawaii" _name="Hawaii" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Hawaii (rainglow)</_description>

    <style name="text" foreground="#e8e1de" background="#333130"/>
    <style name="selection" background="#f75431"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#3b3937"/>
    <style name="line-numbers" foreground="#e8e1de" background="#333130"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#706864"/>
    <style name="def:string" foreground="#a2d66b"/>
    <style name="def:keyword" foreground="#e2922f"/>
    <style name="def:statement" foreground="#f75431"/>
    <style name="def:type" foreground="#edbd44"/>
    <style name="def:function" foreground="#52b4d8"/>
    <style name="def:decimal" foreground="#88c448"/>
    <style name="def:floating-point" foreground="#88c448"/>
    <style name="def:base-n-integer" foreground="#88c448"/>
    <style name="def:special-constant" foreground="#f75431"/>
    <style name="def:constant" foreground="#88c448"/>
    <style name="def:preprocessor" foreground="#968e8a"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
