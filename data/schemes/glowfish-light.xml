<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-glowfish-light" _name="Glowfish Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Glowfish Light (rainglow)</_description>

    <style name="text" foreground="#191f13" background="#e3eadc"/>
    <style name="selection" background="#db784d"/>
    <style name="cursor" foreground="#222222"/>
    <style name="current-line" background="#ebf0e6"/>
    <style name="line-numbers" foreground="#191f13" background="#e3eadc"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#3c4e2d"/>
    <style name="def:string" foreground="#f8bb39"/>
    <style name="def:keyword" foreground="#d65940"/>
    <style name="def:statement" foreground="#db784d"/>
    <style name="def:type" foreground="#95cc5e"/>
    <style name="def:function" foreground="#60a365"/>
    <style name="def:decimal" foreground="#95cc5e"/>
    <style name="def:floating-point" foreground="#95cc5e"/>
    <style name="def:base-n-integer" foreground="#95cc5e"/>
    <style name="def:special-constant" foreground="#db784d"/>
    <style name="def:constant" foreground="#95cc5e"/>
    <style name="def:preprocessor" foreground="#617e49"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
