<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-laracasts-light" _name="Laracasts Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Laracasts Light (rainglow)</_description>

    <style name="text" foreground="#4d545d" background="#ffffff"/>
    <style name="selection" background="#00b1b3"/>
    <style name="cursor" foreground="#333333"/>
    <style name="current-line" background="#ffffff"/>
    <style name="line-numbers" foreground="#4d545d" background="#ffffff"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#9eacbc"/>
    <style name="def:string" foreground="#98d5d6"/>
    <style name="def:keyword" foreground="#00b1b3"/>
    <style name="def:statement" foreground="#ef6733"/>
    <style name="def:type" foreground="#00b1b3"/>
    <style name="def:function" foreground="#4d545d"/>
    <style name="def:decimal" foreground="#c68369"/>
    <style name="def:floating-point" foreground="#c68369"/>
    <style name="def:base-n-integer" foreground="#c68369"/>
    <style name="def:special-constant" foreground="#ef6733"/>
    <style name="def:constant" foreground="#c68369"/>
    <style name="def:preprocessor" foreground="#cbd3db"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
