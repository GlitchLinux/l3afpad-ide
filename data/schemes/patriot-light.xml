<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-patriot-light" name="Patriot Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Patriot Light (rainglow)</description>

    <style name="text" foreground="#333333" background="#ffffff"/>
    <style name="selection" background="#de333c"/>
    <style name="cursor" foreground="#222222"/>
    <style name="current-line" background="#ffffff"/>
    <style name="line-numbers" foreground="#333333" background="#ffffff"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#aaaaaa"/>
    <style name="def:string" foreground="#3790de"/>
    <style name="def:keyword" foreground="#aaaaaa"/>
    <style name="def:statement" foreground="#2e6fd9"/>
    <style name="def:type" foreground="#de333c"/>
    <style name="def:function" foreground="#333333"/>
    <style name="def:decimal" foreground="#2e6fd9"/>
    <style name="def:floating-point" foreground="#2e6fd9"/>
    <style name="def:base-n-integer" foreground="#2e6fd9"/>
    <style name="def:special-constant" foreground="#2e6fd9"/>
    <style name="def:constant" foreground="#2e6fd9"/>
    <style name="def:preprocessor" foreground="#d0d0d0"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
