<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-hyrule" _name="Hyrule" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Hyrule (rainglow)</_description>

    <style name="text" foreground="#c0d5c1" background="#2d2c2b"/>
    <style name="selection" background="#569e16"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#353432"/>
    <style name="line-numbers" foreground="#c0d5c1" background="#2d2c2b"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#716d6a"/>
    <style name="def:string" foreground="#ce830d"/>
    <style name="def:keyword" foreground="#90c93f"/>
    <style name="def:statement" foreground="#569e16"/>
    <style name="def:type" foreground="#f5c504"/>
    <style name="def:function" foreground="#90c93f"/>
    <style name="def:decimal" foreground="#f5c504"/>
    <style name="def:floating-point" foreground="#f5c504"/>
    <style name="def:base-n-integer" foreground="#f5c504"/>
    <style name="def:special-constant" foreground="#569e16"/>
    <style name="def:constant" foreground="#f5c504"/>
    <style name="def:preprocessor" foreground="#979390"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
