<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-stasis-light" name="Stasis Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Stasis Light (rainglow)</description>

    <style name="text" foreground="#605a68" background="#ffffff"/>
    <style name="selection" background="#fc814a"/>
    <style name="cursor" foreground="#333333"/>
    <style name="current-line" background="#ffffff"/>
    <style name="line-numbers" foreground="#605a68" background="#ffffff"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#d0c0e2"/>
    <style name="def:string" foreground="#e5c71b"/>
    <style name="def:keyword" foreground="#fc814a"/>
    <style name="def:statement" foreground="#7c617c"/>
    <style name="def:type" foreground="#fc814a"/>
    <style name="def:function" foreground="#777777"/>
    <style name="def:decimal" foreground="#e5c71b"/>
    <style name="def:floating-point" foreground="#e5c71b"/>
    <style name="def:base-n-integer" foreground="#e5c71b"/>
    <style name="def:special-constant" foreground="#7c617c"/>
    <style name="def:constant" foreground="#e5c71b"/>
    <style name="def:preprocessor" foreground="#f7f4fa"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
