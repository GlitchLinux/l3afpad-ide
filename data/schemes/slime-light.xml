<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-slime-light" name="Slime Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Slime Light (rainglow)</description>

    <style name="text" foreground="#333333" background="#ffffff"/>
    <style name="selection" background="#4e653d"/>
    <style name="cursor" foreground="#222222"/>
    <style name="current-line" background="#ffffff"/>
    <style name="line-numbers" foreground="#333333" background="#ffffff"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#999999"/>
    <style name="def:string" foreground="#8b9355"/>
    <style name="def:keyword" foreground="#9fb3c2"/>
    <style name="def:statement" foreground="#9fb3c2"/>
    <style name="def:type" foreground="#8b9355"/>
    <style name="def:function" foreground="#c7af3f"/>
    <style name="def:decimal" foreground="#c7af3f"/>
    <style name="def:floating-point" foreground="#c7af3f"/>
    <style name="def:base-n-integer" foreground="#c7af3f"/>
    <style name="def:special-constant" foreground="#9fb3c2"/>
    <style name="def:constant" foreground="#c7af3f"/>
    <style name="def:preprocessor" foreground="#bfbfbf"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
