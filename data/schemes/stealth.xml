<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-stealth" _name="Stealth" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Stealth (rainglow)</_description>

    <style name="text" foreground="#5f656d" background="#27292b"/>
    <style name="selection" background="#ffffff"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#2e3133"/>
    <style name="line-numbers" foreground="#5f656d" background="#27292b"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#323538"/>
    <style name="def:string" foreground="#545a60"/>
    <style name="def:keyword" foreground="#474c51"/>
    <style name="def:statement" foreground="#474c51"/>
    <style name="def:type" foreground="#3c4044"/>
    <style name="def:function" foreground="#545a60"/>
    <style name="def:decimal" foreground="#545a60"/>
    <style name="def:floating-point" foreground="#545a60"/>
    <style name="def:base-n-integer" foreground="#545a60"/>
    <style name="def:special-constant" foreground="#474c51"/>
    <style name="def:constant" foreground="#545a60"/>
    <style name="def:preprocessor" foreground="#565b60"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
