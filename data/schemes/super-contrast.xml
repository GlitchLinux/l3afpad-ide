<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-super-contrast" name="Super Contrast" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Super Contrast (rainglow)</description>

    <style name="text" foreground="#ffffff" background="#15191d"/>
    <style name="selection" background="#e45635"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#1b2126"/>
    <style name="line-numbers" foreground="#ffffff" background="#15191d"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#465360"/>
    <style name="def:string" foreground="#f7a21b"/>
    <style name="def:keyword" foreground="#5d67ad"/>
    <style name="def:statement" foreground="#d60257"/>
    <style name="def:type" foreground="#5d67ad"/>
    <style name="def:function" foreground="#e45635"/>
    <style name="def:decimal" foreground="#f7a21b"/>
    <style name="def:floating-point" foreground="#f7a21b"/>
    <style name="def:base-n-integer" foreground="#f7a21b"/>
    <style name="def:special-constant" foreground="#d60257"/>
    <style name="def:constant" foreground="#f7a21b"/>
    <style name="def:preprocessor" foreground="#66798c"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
