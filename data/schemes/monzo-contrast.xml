<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-monzo-contrast" name="Monzo Contrast" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Monzo Contrast (rainglow)</description>

    <style name="text" foreground="#b0cbf4" background="#0b1421"/>
    <style name="selection" background="#98baa6"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#0f1b2c"/>
    <style name="line-numbers" foreground="#b0cbf4" background="#0b1421"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#2c4c7c"/>
    <style name="def:string" foreground="#f63a4e"/>
    <style name="def:keyword" foreground="#e14d61"/>
    <style name="def:statement" foreground="#247888"/>
    <style name="def:type" foreground="#98baa6"/>
    <style name="def:function" foreground="#e6ce9f"/>
    <style name="def:decimal" foreground="#3ea7bc"/>
    <style name="def:floating-point" foreground="#3ea7bc"/>
    <style name="def:base-n-integer" foreground="#3ea7bc"/>
    <style name="def:special-constant" foreground="#247888"/>
    <style name="def:constant" foreground="#3ea7bc"/>
    <style name="def:preprocessor" foreground="#406fb4"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
