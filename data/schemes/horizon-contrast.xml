<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-horizon-contrast" _name="Horizon Contrast" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Horizon Contrast (rainglow)</_description>

    <style name="text" foreground="#edebe6" background="#11101c"/>
    <style name="selection" background="#b133dc"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#171626"/>
    <style name="line-numbers" foreground="#edebe6" background="#11101c"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#36345a"/>
    <style name="def:string" foreground="#fd8a25"/>
    <style name="def:keyword" foreground="#e5194b"/>
    <style name="def:statement" foreground="#b133dc"/>
    <style name="def:type" foreground="#fd8a25"/>
    <style name="def:function" foreground="#fed230"/>
    <style name="def:decimal" foreground="#e524a9"/>
    <style name="def:floating-point" foreground="#e524a9"/>
    <style name="def:base-n-integer" foreground="#e524a9"/>
    <style name="def:special-constant" foreground="#b133dc"/>
    <style name="def:constant" foreground="#e524a9"/>
    <style name="def:preprocessor" foreground="#53508a"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
