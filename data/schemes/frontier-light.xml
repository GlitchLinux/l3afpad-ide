<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-frontier-light" name="Frontier Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Frontier Light (rainglow)</description>

    <style name="text" foreground="#36312c" background="#ffffff"/>
    <style name="selection" background="#1a724a"/>
    <style name="cursor" foreground="#222222"/>
    <style name="current-line" background="#ffffff"/>
    <style name="line-numbers" foreground="#36312c" background="#ffffff"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#cccccc"/>
    <style name="def:string" foreground="#f8bb39"/>
    <style name="def:keyword" foreground="#ba5a27"/>
    <style name="def:statement" foreground="#b22727"/>
    <style name="def:type" foreground="#1a724a"/>
    <style name="def:function" foreground="#af8323"/>
    <style name="def:decimal" foreground="#1a724a"/>
    <style name="def:floating-point" foreground="#1a724a"/>
    <style name="def:base-n-integer" foreground="#1a724a"/>
    <style name="def:special-constant" foreground="#b22727"/>
    <style name="def:constant" foreground="#1a724a"/>
    <style name="def:preprocessor" foreground="#f2f2f2"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
