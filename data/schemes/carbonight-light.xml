<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-carbonight-light" _name="Carbonight Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Carbonight Light (rainglow)</_description>

    <style name="text" foreground="#2e2c2b" background="#ffffff"/>
    <style name="selection" background="#8c8c8c"/>
    <style name="cursor" foreground="#222222"/>
    <style name="current-line" background="#ffffff"/>
    <style name="line-numbers" foreground="#2e2c2b" background="#ffffff"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#cccccc"/>
    <style name="def:string" foreground="#888888"/>
    <style name="def:keyword" foreground="#555555"/>
    <style name="def:statement" foreground="#8c8c8c"/>
    <style name="def:type" foreground="#c4c4c4"/>
    <style name="def:function" foreground="#222222"/>
    <style name="def:decimal" foreground="#b0b0b0"/>
    <style name="def:floating-point" foreground="#b0b0b0"/>
    <style name="def:base-n-integer" foreground="#b0b0b0"/>
    <style name="def:special-constant" foreground="#8c8c8c"/>
    <style name="def:constant" foreground="#b0b0b0"/>
    <style name="def:preprocessor" foreground="#f2f2f2"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
