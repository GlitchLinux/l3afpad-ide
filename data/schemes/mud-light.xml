<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-mud-light" name="Mud Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Mud Light (rainglow)</description>

    <style name="text" foreground="#555555" background="#ede8e8"/>
    <style name="selection" background="#88ad6e"/>
    <style name="cursor" foreground="#222222"/>
    <style name="current-line" background="#f4f1f1"/>
    <style name="line-numbers" foreground="#555555" background="#ede8e8"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#c3b8b7"/>
    <style name="def:string" foreground="#88ad6e"/>
    <style name="def:keyword" foreground="#d16f60"/>
    <style name="def:statement" foreground="#d16f60"/>
    <style name="def:type" foreground="#c4a446"/>
    <style name="def:function" foreground="#88ad6e"/>
    <style name="def:decimal" foreground="#88ad6e"/>
    <style name="def:floating-point" foreground="#88ad6e"/>
    <style name="def:base-n-integer" foreground="#88ad6e"/>
    <style name="def:special-constant" foreground="#d16f60"/>
    <style name="def:constant" foreground="#88ad6e"/>
    <style name="def:preprocessor" foreground="#e6e1e1"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
