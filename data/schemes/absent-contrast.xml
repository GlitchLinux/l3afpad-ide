<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-absent-contrast" name="Absent Contrast" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Absent Contrast (rainglow)</description>

    <style name="text" foreground="#aeb9c4" background="#0e1114"/>
    <style name="selection" background="#228a96"/>
    <style name="cursor" foreground="#ffffff"/>
    <style name="current-line" background="#14191d"/>
    <style name="line-numbers" foreground="#aeb9c4" background="#0e1114"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#44515e"/>
    <style name="def:string" foreground="#addbbc"/>
    <style name="def:keyword" foreground="#228a96"/>
    <style name="def:statement" foreground="#6ba77f"/>
    <style name="def:type" foreground="#228a96"/>
    <style name="def:function" foreground="#e6eaef"/>
    <style name="def:decimal" foreground="#61bcc6"/>
    <style name="def:floating-point" foreground="#61bcc6"/>
    <style name="def:base-n-integer" foreground="#61bcc6"/>
    <style name="def:special-constant" foreground="#6ba77f"/>
    <style name="def:constant" foreground="#61bcc6"/>
    <style name="def:preprocessor" foreground="#64778a"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
