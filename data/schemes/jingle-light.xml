<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-jingle-light" name="Jingle Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Jingle Light (rainglow)</description>

    <style name="text" foreground="#485860" background="#ffffff"/>
    <style name="selection" background="#7ec579"/>
    <style name="cursor" foreground="#333333"/>
    <style name="current-line" background="#ffffff"/>
    <style name="line-numbers" foreground="#485860" background="#ffffff"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#aab8bf"/>
    <style name="def:string" foreground="#84c4ce"/>
    <style name="def:keyword" foreground="#e06d5c"/>
    <style name="def:statement" foreground="#7ec579"/>
    <style name="def:type" foreground="#e06d5c"/>
    <style name="def:function" foreground="#98abb7"/>
    <style name="def:decimal" foreground="#e0ad5c"/>
    <style name="def:floating-point" foreground="#e0ad5c"/>
    <style name="def:base-n-integer" foreground="#e0ad5c"/>
    <style name="def:special-constant" foreground="#7ec579"/>
    <style name="def:constant" foreground="#e0ad5c"/>
    <style name="def:preprocessor" foreground="#d6dce0"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
