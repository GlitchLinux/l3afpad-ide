<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-grunge-light" name="Grunge Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Grunge Light (rainglow)</description>

    <style name="text" foreground="#31332c" background="#f8f8f2"/>
    <style name="selection" background="#f56991"/>
    <style name="cursor" foreground="#222222"/>
    <style name="current-line" background="#fdfdfc"/>
    <style name="line-numbers" foreground="#31332c" background="#f8f8f2"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#5c634f"/>
    <style name="def:string" foreground="#abc687"/>
    <style name="def:keyword" foreground="#91a374"/>
    <style name="def:statement" foreground="#f56991"/>
    <style name="def:type" foreground="#abc687"/>
    <style name="def:function" foreground="#ffc48c"/>
    <style name="def:decimal" foreground="#f56991"/>
    <style name="def:floating-point" foreground="#f56991"/>
    <style name="def:base-n-integer" foreground="#f56991"/>
    <style name="def:special-constant" foreground="#f56991"/>
    <style name="def:constant" foreground="#f56991"/>
    <style name="def:preprocessor" foreground="#848e71"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
