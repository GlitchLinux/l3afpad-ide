<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-warlock-contrast" name="Warlock Contrast" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Warlock Contrast (rainglow)</description>

    <style name="text" foreground="#ffffff" background="#171123"/>
    <style name="selection" background="#725ac1"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#1e162d"/>
    <style name="line-numbers" foreground="#ffffff" background="#171123"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#726c87"/>
    <style name="def:string" foreground="#f78362"/>
    <style name="def:keyword" foreground="#9559c6"/>
    <style name="def:statement" foreground="#5b85aa"/>
    <style name="def:type" foreground="#f46036"/>
    <style name="def:function" foreground="#5b64a3"/>
    <style name="def:decimal" foreground="#f7a261"/>
    <style name="def:floating-point" foreground="#f7a261"/>
    <style name="def:base-n-integer" foreground="#f7a261"/>
    <style name="def:special-constant" foreground="#5b85aa"/>
    <style name="def:constant" foreground="#f7a261"/>
    <style name="def:preprocessor" foreground="#9a95aa"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
