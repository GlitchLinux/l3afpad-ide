<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-box-uk-contrast" _name="Box UK Contrast" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Box UK Contrast (rainglow)</_description>

    <style name="text" foreground="#ffffff" background="#111519"/>
    <style name="selection" background="#017c9d"/>
    <style name="cursor" foreground="#ffffff"/>
    <style name="current-line" background="#171d22"/>
    <style name="line-numbers" foreground="#ffffff" background="#111519"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#60778c"/>
    <style name="def:string" foreground="#15b8ae"/>
    <style name="def:keyword" foreground="#017c9d"/>
    <style name="def:statement" foreground="#019d76"/>
    <style name="def:type" foreground="#017c9d"/>
    <style name="def:function" foreground="#15b8ae"/>
    <style name="def:decimal" foreground="#15b8ae"/>
    <style name="def:floating-point" foreground="#15b8ae"/>
    <style name="def:base-n-integer" foreground="#15b8ae"/>
    <style name="def:special-constant" foreground="#019d76"/>
    <style name="def:constant" foreground="#15b8ae"/>
    <style name="def:preprocessor" foreground="#8a9daf"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
