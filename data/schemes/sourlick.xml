<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-sourlick" _name="Sourlick" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Sourlick (rainglow)</_description>

    <style name="text" foreground="#dedede" background="#2e2c2b"/>
    <style name="selection" background="#518f0d"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#363432"/>
    <style name="line-numbers" foreground="#dedede" background="#2e2c2b"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#615953"/>
    <style name="def:string" foreground="#e4ff33"/>
    <style name="def:keyword" foreground="#d2eb31"/>
    <style name="def:statement" foreground="#8ac27a"/>
    <style name="def:type" foreground="#edf252"/>
    <style name="def:function" foreground="#bdf522"/>
    <style name="def:decimal" foreground="#fc580c"/>
    <style name="def:floating-point" foreground="#fc580c"/>
    <style name="def:base-n-integer" foreground="#fc580c"/>
    <style name="def:special-constant" foreground="#8ac27a"/>
    <style name="def:constant" foreground="#fc580c"/>
    <style name="def:preprocessor" foreground="#8a7f76"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
