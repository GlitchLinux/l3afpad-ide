<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-jumper-light" _name="Jumper Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Jumper Light (rainglow)</_description>

    <style name="text" foreground="#222a2a" background="#ffffff"/>
    <style name="selection" background="#36a595"/>
    <style name="cursor" foreground="#222222"/>
    <style name="current-line" background="#ffffff"/>
    <style name="line-numbers" foreground="#222a2a" background="#ffffff"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#cccccc"/>
    <style name="def:string" foreground="#63a5a5"/>
    <style name="def:keyword" foreground="#e08e4c"/>
    <style name="def:statement" foreground="#c9b230"/>
    <style name="def:type" foreground="#36a595"/>
    <style name="def:function" foreground="#db515c"/>
    <style name="def:decimal" foreground="#4eadad"/>
    <style name="def:floating-point" foreground="#4eadad"/>
    <style name="def:base-n-integer" foreground="#4eadad"/>
    <style name="def:special-constant" foreground="#c9b230"/>
    <style name="def:constant" foreground="#4eadad"/>
    <style name="def:preprocessor" foreground="#f2f2f2"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
