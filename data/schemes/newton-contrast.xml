<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-newton-contrast" _name="Newton Contrast" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Newton Contrast (rainglow)</_description>

    <style name="text" foreground="#eaebff" background="#121014"/>
    <style name="selection" background="#ff5d38"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#1a171c"/>
    <style name="line-numbers" foreground="#eaebff" background="#121014"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#3d3744"/>
    <style name="def:string" foreground="#9fd356"/>
    <style name="def:keyword" foreground="#fa824c"/>
    <style name="def:statement" foreground="#ffbf69"/>
    <style name="def:type" foreground="#fa824c"/>
    <style name="def:function" foreground="#3c91e6"/>
    <style name="def:decimal" foreground="#9fd356"/>
    <style name="def:floating-point" foreground="#9fd356"/>
    <style name="def:base-n-integer" foreground="#9fd356"/>
    <style name="def:special-constant" foreground="#ffbf69"/>
    <style name="def:constant" foreground="#9fd356"/>
    <style name="def:preprocessor" foreground="#63596e"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
