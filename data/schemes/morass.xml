<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-morass" _name="Morass" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Morass (rainglow)</_description>

    <style name="text" foreground="#e4e3e1" background="#313a36"/>
    <style name="selection" background="#fdec5a"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#38423e"/>
    <style name="line-numbers" foreground="#e4e3e1" background="#313a36"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#63776d"/>
    <style name="def:string" foreground="#f8bb39"/>
    <style name="def:keyword" foreground="#afd0c4"/>
    <style name="def:statement" foreground="#68875a"/>
    <style name="def:type" foreground="#fdec5a"/>
    <style name="def:function" foreground="#afb54c"/>
    <style name="def:decimal" foreground="#f8bb39"/>
    <style name="def:floating-point" foreground="#f8bb39"/>
    <style name="def:base-n-integer" foreground="#f8bb39"/>
    <style name="def:special-constant" foreground="#68875a"/>
    <style name="def:constant" foreground="#f8bb39"/>
    <style name="def:preprocessor" foreground="#899d93"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
