<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-slime-contrast" name="Slime Contrast" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Slime Contrast (rainglow)</description>

    <style name="text" foreground="#ffffff" background="#0b0c0d"/>
    <style name="selection" background="#c7af3f"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#121415"/>
    <style name="line-numbers" foreground="#ffffff" background="#0b0c0d"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#4f5a63"/>
    <style name="def:string" foreground="#faffdb"/>
    <style name="def:keyword" foreground="#689dc5"/>
    <style name="def:statement" foreground="#6a9ec5"/>
    <style name="def:type" foreground="#d8e778"/>
    <style name="def:function" foreground="#d0b123"/>
    <style name="def:decimal" foreground="#c7af3f"/>
    <style name="def:floating-point" foreground="#c7af3f"/>
    <style name="def:base-n-integer" foreground="#c7af3f"/>
    <style name="def:special-constant" foreground="#6a9ec5"/>
    <style name="def:constant" foreground="#c7af3f"/>
    <style name="def:preprocessor" foreground="#71818e"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
