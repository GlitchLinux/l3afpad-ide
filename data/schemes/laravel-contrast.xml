<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-laravel-contrast" name="Laravel Contrast" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Laravel Contrast (rainglow)</description>

    <style name="text" foreground="#ffffff" background="#000000"/>
    <style name="selection" background="#cd724e"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#080808"/>
    <style name="line-numbers" foreground="#ffffff" background="#000000"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#615953"/>
    <style name="def:string" foreground="#fdca49"/>
    <style name="def:keyword" foreground="#ffa927"/>
    <style name="def:statement" foreground="#fc6b0a"/>
    <style name="def:type" foreground="#ffc48c"/>
    <style name="def:function" foreground="#fc580c"/>
    <style name="def:decimal" foreground="#fc580c"/>
    <style name="def:floating-point" foreground="#fc580c"/>
    <style name="def:base-n-integer" foreground="#fc580c"/>
    <style name="def:special-constant" foreground="#fc6b0a"/>
    <style name="def:constant" foreground="#fc580c"/>
    <style name="def:preprocessor" foreground="#8a7f76"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
