<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-fodder" name="Fodder" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Fodder (rainglow)</description>

    <style name="text" foreground="#cce0d6" background="#2d4137"/>
    <style name="selection" background="#fcfcfa"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#334a3f"/>
    <style name="line-numbers" foreground="#cce0d6" background="#2d4137"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#5f8c75"/>
    <style name="def:string" foreground="#f7a21b"/>
    <style name="def:keyword" foreground="#98d046"/>
    <style name="def:statement" foreground="#98d046"/>
    <style name="def:type" foreground="#ad9895"/>
    <style name="def:function" foreground="#fcfcfa"/>
    <style name="def:decimal" foreground="#f7a21b"/>
    <style name="def:floating-point" foreground="#f7a21b"/>
    <style name="def:base-n-integer" foreground="#f7a21b"/>
    <style name="def:special-constant" foreground="#98d046"/>
    <style name="def:constant" foreground="#f7a21b"/>
    <style name="def:preprocessor" foreground="#89af9b"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
