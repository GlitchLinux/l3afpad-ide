<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-laravel-light" _name="Laravel Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Laravel Light (rainglow)</_description>

    <style name="text" foreground="#444444" background="#ffffff"/>
    <style name="selection" background="#fc580c"/>
    <style name="cursor" foreground="#222222"/>
    <style name="current-line" background="#ffffff"/>
    <style name="line-numbers" foreground="#444444" background="#ffffff"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#aaaaaa"/>
    <style name="def:string" foreground="#fdca49"/>
    <style name="def:keyword" foreground="#ffa927"/>
    <style name="def:statement" foreground="#fc6b0a"/>
    <style name="def:type" foreground="#ffc48c"/>
    <style name="def:function" foreground="#fc580c"/>
    <style name="def:decimal" foreground="#fc580c"/>
    <style name="def:floating-point" foreground="#fc580c"/>
    <style name="def:base-n-integer" foreground="#fc580c"/>
    <style name="def:special-constant" foreground="#fc6b0a"/>
    <style name="def:constant" foreground="#fc580c"/>
    <style name="def:preprocessor" foreground="#d0d0d0"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
