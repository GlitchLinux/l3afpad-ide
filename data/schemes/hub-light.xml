<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-hub-light" _name="Hub Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Hub Light (rainglow)</_description>

    <style name="text" foreground="#24292e" background="#ffffff"/>
    <style name="selection" background="#077cf9"/>
    <style name="cursor" foreground="#222222"/>
    <style name="current-line" background="#fffbdd"/>
    <style name="line-numbers" foreground="#24292e" background="#ffffff"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#6a737d"/>
    <style name="def:string" foreground="#032f62"/>
    <style name="def:keyword" foreground="#d73a49"/>
    <style name="def:statement" foreground="#005cc5"/>
    <style name="def:type" foreground="#d73a49"/>
    <style name="def:function" foreground="#005cc5"/>
    <style name="def:decimal" foreground="#032f62"/>
    <style name="def:floating-point" foreground="#032f62"/>
    <style name="def:base-n-integer" foreground="#032f62"/>
    <style name="def:special-constant" foreground="#005cc5"/>
    <style name="def:constant" foreground="#032f62"/>
    <style name="def:preprocessor" foreground="#9199a2"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
