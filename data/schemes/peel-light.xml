<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-peel-light" _name="Peel Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Peel Light (rainglow)</_description>

    <style name="text" foreground="#333333" background="#ffffff"/>
    <style name="selection" background="#d3643b"/>
    <style name="cursor" foreground="#222222"/>
    <style name="current-line" background="#ffffff"/>
    <style name="line-numbers" foreground="#333333" background="#ffffff"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#aaaaaa"/>
    <style name="def:string" foreground="#f4d370"/>
    <style name="def:keyword" foreground="#94c7b6"/>
    <style name="def:statement" foreground="#d3643b"/>
    <style name="def:type" foreground="#94c7b6"/>
    <style name="def:function" foreground="#b2bca4"/>
    <style name="def:decimal" foreground="#f4d370"/>
    <style name="def:floating-point" foreground="#f4d370"/>
    <style name="def:base-n-integer" foreground="#f4d370"/>
    <style name="def:special-constant" foreground="#d3643b"/>
    <style name="def:constant" foreground="#f4d370"/>
    <style name="def:preprocessor" foreground="#d0d0d0"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
