<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-comrade-contrast" _name="Comrade Contrast" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Comrade Contrast (rainglow)</_description>

    <style name="text" foreground="#d6dbdb" background="#121414"/>
    <style name="selection" background="#9bb7a7"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#191c1c"/>
    <style name="line-numbers" foreground="#d6dbdb" background="#121414"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#3b4747"/>
    <style name="def:string" foreground="#63a5a5"/>
    <style name="def:keyword" foreground="#9bb7a7"/>
    <style name="def:statement" foreground="#9bb7a7"/>
    <style name="def:type" foreground="#c24e4b"/>
    <style name="def:function" foreground="#f9f7f1"/>
    <style name="def:decimal" foreground="#4eadad"/>
    <style name="def:floating-point" foreground="#4eadad"/>
    <style name="def:base-n-integer" foreground="#4eadad"/>
    <style name="def:special-constant" foreground="#9bb7a7"/>
    <style name="def:constant" foreground="#4eadad"/>
    <style name="def:preprocessor" foreground="#5e7171"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
