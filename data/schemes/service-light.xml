<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-service-light" _name="Service Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Service Light (rainglow)</_description>

    <style name="text" foreground="#4d5151" background="#ffffff"/>
    <style name="selection" background="#a2d66b"/>
    <style name="cursor" foreground="#333333"/>
    <style name="current-line" background="#ffffff"/>
    <style name="line-numbers" foreground="#4d5151" background="#ffffff"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#b1c9c9"/>
    <style name="def:string" foreground="#a2d66b"/>
    <style name="def:keyword" foreground="#a0afa1"/>
    <style name="def:statement" foreground="#a0afa1"/>
    <style name="def:type" foreground="#6c8375"/>
    <style name="def:function" foreground="#8c9191"/>
    <style name="def:decimal" foreground="#88c448"/>
    <style name="def:floating-point" foreground="#88c448"/>
    <style name="def:base-n-integer" foreground="#88c448"/>
    <style name="def:special-constant" foreground="#a0afa1"/>
    <style name="def:constant" foreground="#88c448"/>
    <style name="def:preprocessor" foreground="#dee8e8"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
