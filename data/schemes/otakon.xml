<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-otakon" name="Otakon" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Otakon (rainglow)</description>

    <style name="text" foreground="#f9f3f9" background="#3f373f"/>
    <style name="selection" background="#b1a6ca"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#473e47"/>
    <style name="line-numbers" foreground="#f9f3f9" background="#3f373f"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#6a6a84"/>
    <style name="def:string" foreground="#9eb2d9"/>
    <style name="def:keyword" foreground="#cacbdd"/>
    <style name="def:statement" foreground="#f6e6eb"/>
    <style name="def:type" foreground="#b1a6ca"/>
    <style name="def:function" foreground="#e484b2"/>
    <style name="def:decimal" foreground="#9eb2d9"/>
    <style name="def:floating-point" foreground="#9eb2d9"/>
    <style name="def:base-n-integer" foreground="#9eb2d9"/>
    <style name="def:special-constant" foreground="#f6e6eb"/>
    <style name="def:constant" foreground="#9eb2d9"/>
    <style name="def:preprocessor" foreground="#9393a8"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
