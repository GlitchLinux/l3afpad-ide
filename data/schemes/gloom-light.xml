<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-gloom-light" name="Gloom Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Gloom Light (rainglow)</description>

    <style name="text" foreground="#2a332b" background="#d8ebe5"/>
    <style name="selection" background="#ff5d38"/>
    <style name="cursor" foreground="#222222"/>
    <style name="current-line" background="#e2f0ec"/>
    <style name="line-numbers" foreground="#2a332b" background="#d8ebe5"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#4f6e64"/>
    <style name="def:string" foreground="#98ad0d"/>
    <style name="def:keyword" foreground="#26a6a6"/>
    <style name="def:statement" foreground="#ff5d38"/>
    <style name="def:type" foreground="#26a6a6"/>
    <style name="def:function" foreground="#98ad0d"/>
    <style name="def:decimal" foreground="#98ad0d"/>
    <style name="def:floating-point" foreground="#98ad0d"/>
    <style name="def:base-n-integer" foreground="#98ad0d"/>
    <style name="def:special-constant" foreground="#ff5d38"/>
    <style name="def:constant" foreground="#98ad0d"/>
    <style name="def:preprocessor" foreground="#71998c"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
