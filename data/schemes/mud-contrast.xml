<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-mud-contrast" _name="Mud Contrast" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Mud Contrast (rainglow)</_description>

    <style name="text" foreground="#ffffff" background="#0d0b0b"/>
    <style name="selection" background="#b5db99"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#151212"/>
    <style name="line-numbers" foreground="#ffffff" background="#0d0b0b"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#524343"/>
    <style name="def:string" foreground="#b5db99"/>
    <style name="def:keyword" foreground="#f8553c"/>
    <style name="def:statement" foreground="#f55239"/>
    <style name="def:type" foreground="#f2c12f"/>
    <style name="def:function" foreground="#8ee350"/>
    <style name="def:decimal" foreground="#b5db99"/>
    <style name="def:floating-point" foreground="#b5db99"/>
    <style name="def:base-n-integer" foreground="#b5db99"/>
    <style name="def:special-constant" foreground="#f55239"/>
    <style name="def:constant" foreground="#b5db99"/>
    <style name="def:preprocessor" foreground="#7c6565"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
