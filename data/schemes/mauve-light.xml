<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-mauve-light" _name="Mauve Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Mauve Light (rainglow)</_description>

    <style name="text" foreground="#372638" background="#ffffff"/>
    <style name="selection" background="#c89933"/>
    <style name="cursor" foreground="#333333"/>
    <style name="current-line" background="#ffffff"/>
    <style name="line-numbers" foreground="#372638" background="#ffffff"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#cc8ed1"/>
    <style name="def:string" foreground="#baa353"/>
    <style name="def:keyword" foreground="#c89933"/>
    <style name="def:statement" foreground="#74526c"/>
    <style name="def:type" foreground="#c89933"/>
    <style name="def:function" foreground="#dbd053"/>
    <style name="def:decimal" foreground="#d8b436"/>
    <style name="def:floating-point" foreground="#d8b436"/>
    <style name="def:base-n-integer" foreground="#d8b436"/>
    <style name="def:special-constant" foreground="#74526c"/>
    <style name="def:constant" foreground="#d8b436"/>
    <style name="def:preprocessor" foreground="#e5c4e7"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
