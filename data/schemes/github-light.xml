<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-github-light" _name="Github Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Github Light (rainglow)</_description>

    <style name="text" foreground="#555555" background="#ffffff"/>
    <style name="selection" background="#008080"/>
    <style name="cursor" foreground="#444444"/>
    <style name="current-line" background="#ffffff"/>
    <style name="line-numbers" foreground="#555555" background="#ffffff"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#b8b6b1"/>
    <style name="def:string" foreground="#dd1144"/>
    <style name="def:keyword" foreground="#555555"/>
    <style name="def:statement" foreground="#008080"/>
    <style name="def:type" foreground="#445588"/>
    <style name="def:function" foreground="#dd1144"/>
    <style name="def:decimal" foreground="#dd1144"/>
    <style name="def:floating-point" foreground="#dd1144"/>
    <style name="def:base-n-integer" foreground="#dd1144"/>
    <style name="def:special-constant" foreground="#008080"/>
    <style name="def:constant" foreground="#dd1144"/>
    <style name="def:preprocessor" foreground="#dcdbd9"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
