<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-yitzchok-light" _name="Yitzchok Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Yitzchok Light (rainglow)</_description>

    <style name="text" foreground="#6a7684" background="#ffffff"/>
    <style name="selection" background="#e7be45"/>
    <style name="cursor" foreground="#333333"/>
    <style name="current-line" background="#ffffff"/>
    <style name="line-numbers" foreground="#6a7684" background="#ffffff"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#aeb9c4"/>
    <style name="def:string" foreground="#afa441"/>
    <style name="def:keyword" foreground="#e7be45"/>
    <style name="def:statement" foreground="#7a8289"/>
    <style name="def:type" foreground="#e7be45"/>
    <style name="def:function" foreground="#6a7684"/>
    <style name="def:decimal" foreground="#998d29"/>
    <style name="def:floating-point" foreground="#998d29"/>
    <style name="def:base-n-integer" foreground="#998d29"/>
    <style name="def:special-constant" foreground="#7a8289"/>
    <style name="def:constant" foreground="#998d29"/>
    <style name="def:preprocessor" foreground="#dadfe4"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
