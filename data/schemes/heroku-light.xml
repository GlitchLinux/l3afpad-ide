<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-heroku-light" name="Heroku Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Heroku Light (rainglow)</description>

    <style name="text" foreground="#1b1b24" background="#f7f7fc"/>
    <style name="selection" background="#7873ae"/>
    <style name="cursor" foreground="#222222"/>
    <style name="current-line" background="#ffffff"/>
    <style name="line-numbers" foreground="#1b1b24" background="#f7f7fc"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#505067"/>
    <style name="def:string" foreground="#6daf36"/>
    <style name="def:keyword" foreground="#7873ae"/>
    <style name="def:statement" foreground="#7873ae"/>
    <style name="def:type" foreground="#585480"/>
    <style name="def:function" foreground="#b0add3"/>
    <style name="def:decimal" foreground="#6daf36"/>
    <style name="def:floating-point" foreground="#6daf36"/>
    <style name="def:base-n-integer" foreground="#6daf36"/>
    <style name="def:special-constant" foreground="#7873ae"/>
    <style name="def:constant" foreground="#6daf36"/>
    <style name="def:preprocessor" foreground="#727291"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
