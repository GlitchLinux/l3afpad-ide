<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-warlock" _name="Warlock" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Warlock (rainglow)</_description>

    <style name="text" foreground="#ffffff" background="#4b4060"/>
    <style name="selection" background="#725ac1"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#524669"/>
    <style name="line-numbers" foreground="#ffffff" background="#4b4060"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#7c6d96"/>
    <style name="def:string" foreground="#f78362"/>
    <style name="def:keyword" foreground="#b67ae8"/>
    <style name="def:statement" foreground="#7eb1dd"/>
    <style name="def:type" foreground="#f46036"/>
    <style name="def:function" foreground="#7c86d6"/>
    <style name="def:decimal" foreground="#f7a261"/>
    <style name="def:floating-point" foreground="#f7a261"/>
    <style name="def:base-n-integer" foreground="#f7a261"/>
    <style name="def:special-constant" foreground="#7eb1dd"/>
    <style name="def:constant" foreground="#f7a261"/>
    <style name="def:preprocessor" foreground="#a499b6"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
