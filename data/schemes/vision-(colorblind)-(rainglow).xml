<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-vision-(colorblind)-(rainglow)" _name="Vision (colorblind)" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Vision (colorblind) (rainglow)</_description>

    <style name="text" foreground="#ffffff" background="#000000"/>
    <style name="selection" background="#f87856"/>
    <style name="cursor" foreground="#ffffff"/>
    <style name="current-line" background="#080808"/>
    <style name="line-numbers" foreground="#ffffff" background="#000000"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#555555"/>
    <style name="def:string" foreground="#21c0fc"/>
    <style name="def:keyword" foreground="#136efb"/>
    <style name="def:statement" foreground="#fdba2c"/>
    <style name="def:type" foreground="#fc4d1f"/>
    <style name="def:function" foreground="#21c0fc"/>
    <style name="def:decimal" foreground="#fdba2c"/>
    <style name="def:floating-point" foreground="#fdba2c"/>
    <style name="def:base-n-integer" foreground="#fdba2c"/>
    <style name="def:special-constant" foreground="#fdba2c"/>
    <style name="def:constant" foreground="#fdba2c"/>
    <style name="def:preprocessor" foreground="#7b7b7b"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
