<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-vegetable-light" _name="Vegetable Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Vegetable Light (rainglow)</_description>

    <style name="text" foreground="#514547" background="#e2dcdd"/>
    <style name="selection" background="#689d81"/>
    <style name="cursor" foreground="#333333"/>
    <style name="current-line" background="#e9e4e5"/>
    <style name="line-numbers" foreground="#514547" background="#e2dcdd"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#b2a2a5"/>
    <style name="def:string" foreground="#bc6b79"/>
    <style name="def:keyword" foreground="#f0a56c"/>
    <style name="def:statement" foreground="#689d81"/>
    <style name="def:type" foreground="#f0a56c"/>
    <style name="def:function" foreground="#c6a52d"/>
    <style name="def:decimal" foreground="#bcae6b"/>
    <style name="def:floating-point" foreground="#bcae6b"/>
    <style name="def:base-n-integer" foreground="#bcae6b"/>
    <style name="def:special-constant" foreground="#689d81"/>
    <style name="def:constant" foreground="#bcae6b"/>
    <style name="def:preprocessor" foreground="#d5cccd"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
