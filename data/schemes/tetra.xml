<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-tetra" _name="Tetra" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Tetra (rainglow)</_description>

    <style name="text" foreground="#c9d7db" background="#13363f"/>
    <style name="selection" background="#148b97"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#17404b"/>
    <style name="line-numbers" foreground="#c9d7db" background="#13363f"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#3b5f68"/>
    <style name="def:string" foreground="#7fc181"/>
    <style name="def:keyword" foreground="#e2585d"/>
    <style name="def:statement" foreground="#fdce7f"/>
    <style name="def:type" foreground="#148b97"/>
    <style name="def:function" foreground="#e8744a"/>
    <style name="def:decimal" foreground="#7fc181"/>
    <style name="def:floating-point" foreground="#7fc181"/>
    <style name="def:base-n-integer" foreground="#7fc181"/>
    <style name="def:special-constant" foreground="#fdce7f"/>
    <style name="def:constant" foreground="#7fc181"/>
    <style name="def:preprocessor" foreground="#578c99"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
