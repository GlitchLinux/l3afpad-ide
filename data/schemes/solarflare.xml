<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-solarflare" _name="Solarflare" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Solarflare (rainglow)</_description>

    <style name="text" foreground="#e3e2e0" background="#222222"/>
    <style name="selection" background="#ff4e50"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#2a2a2a"/>
    <style name="line-numbers" foreground="#e3e2e0" background="#222222"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#777777"/>
    <style name="def:string" foreground="#ede574"/>
    <style name="def:keyword" foreground="#ff4e50"/>
    <style name="def:statement" foreground="#ff4e50"/>
    <style name="def:type" foreground="#fc913a"/>
    <style name="def:function" foreground="#ede574"/>
    <style name="def:decimal" foreground="#ff4e50"/>
    <style name="def:floating-point" foreground="#ff4e50"/>
    <style name="def:base-n-integer" foreground="#ff4e50"/>
    <style name="def:special-constant" foreground="#ff4e50"/>
    <style name="def:constant" foreground="#ff4e50"/>
    <style name="def:preprocessor" foreground="#9d9d9d"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
