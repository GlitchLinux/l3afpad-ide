<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-vision-light-(colorblind)-(rainglow)" _name="Vision Light (colorblind)" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Vision Light (colorblind) (rainglow)</_description>

    <style name="text" foreground="#000000" background="#ffffff"/>
    <style name="selection" background="#f87856"/>
    <style name="cursor" foreground="#000000"/>
    <style name="current-line" background="#ffffff"/>
    <style name="line-numbers" foreground="#000000" background="#ffffff"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#555555"/>
    <style name="def:string" foreground="#0b6aa5"/>
    <style name="def:keyword" foreground="#f87856"/>
    <style name="def:statement" foreground="#1ba2f7"/>
    <style name="def:type" foreground="#81209e"/>
    <style name="def:function" foreground="#f87856"/>
    <style name="def:decimal" foreground="#0b6aa5"/>
    <style name="def:floating-point" foreground="#0b6aa5"/>
    <style name="def:base-n-integer" foreground="#0b6aa5"/>
    <style name="def:special-constant" foreground="#1ba2f7"/>
    <style name="def:constant" foreground="#0b6aa5"/>
    <style name="def:preprocessor" foreground="#7b7b7b"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
