<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-soup" name="Soup" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Soup (rainglow)</description>

    <style name="text" foreground="#9090b2" background="#40424c"/>
    <style name="selection" background="#68b0ab"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#474954"/>
    <style name="line-numbers" foreground="#9090b2" background="#40424c"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#6b6e7f"/>
    <style name="def:string" foreground="#baa353"/>
    <style name="def:keyword" foreground="#faf3dd"/>
    <style name="def:statement" foreground="#8fc0a9"/>
    <style name="def:type" foreground="#68b0ab"/>
    <style name="def:function" foreground="#c8d5b9"/>
    <style name="def:decimal" foreground="#d8b436"/>
    <style name="def:floating-point" foreground="#d8b436"/>
    <style name="def:base-n-integer" foreground="#d8b436"/>
    <style name="def:special-constant" foreground="#8fc0a9"/>
    <style name="def:constant" foreground="#d8b436"/>
    <style name="def:preprocessor" foreground="#9395a4"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
