<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-azure-contrast" _name="Azure Contrast" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Azure Contrast (rainglow)</_description>

    <style name="text" foreground="#ffffff" background="#040507"/>
    <style name="selection" background="#47959a"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#0a0c11"/>
    <style name="line-numbers" foreground="#ffffff" background="#040507"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#414d62"/>
    <style name="def:string" foreground="#64aeb3"/>
    <style name="def:keyword" foreground="#508aaa"/>
    <style name="def:statement" foreground="#52708b"/>
    <style name="def:type" foreground="#6ab0a3"/>
    <style name="def:function" foreground="#508aaa"/>
    <style name="def:decimal" foreground="#64aeb3"/>
    <style name="def:floating-point" foreground="#64aeb3"/>
    <style name="def:base-n-integer" foreground="#64aeb3"/>
    <style name="def:special-constant" foreground="#52708b"/>
    <style name="def:constant" foreground="#64aeb3"/>
    <style name="def:preprocessor" foreground="#607190"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
