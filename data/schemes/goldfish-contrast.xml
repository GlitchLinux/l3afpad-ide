<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-goldfish-contrast" _name="Goldfish Contrast" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Goldfish Contrast (rainglow)</_description>

    <style name="text" foreground="#f8f8f2" background="#0c0d0e"/>
    <style name="selection" background="#f38630"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#131516"/>
    <style name="line-numbers" foreground="#f8f8f2" background="#0c0d0e"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#505c63"/>
    <style name="def:string" foreground="#f36e3a"/>
    <style name="def:keyword" foreground="#a7dbd8"/>
    <style name="def:statement" foreground="#fa6900"/>
    <style name="def:type" foreground="#f38630"/>
    <style name="def:function" foreground="#69d2e7"/>
    <style name="def:decimal" foreground="#f25619"/>
    <style name="def:floating-point" foreground="#f25619"/>
    <style name="def:base-n-integer" foreground="#f25619"/>
    <style name="def:special-constant" foreground="#fa6900"/>
    <style name="def:constant" foreground="#f25619"/>
    <style name="def:preprocessor" foreground="#72838d"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
