<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-iceberg" name="Iceberg" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Iceberg (rainglow)</description>

    <style name="text" foreground="#bdd6db" background="#323b3d"/>
    <style name="selection" background="#2d8da1"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#394345"/>
    <style name="line-numbers" foreground="#bdd6db" background="#323b3d"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#537178"/>
    <style name="def:string" foreground="#ffffff"/>
    <style name="def:keyword" foreground="#b1e2f2"/>
    <style name="def:statement" foreground="#2d8da1"/>
    <style name="def:type" foreground="#59c0e3"/>
    <style name="def:function" foreground="#ffffff"/>
    <style name="def:decimal" foreground="#ffffff"/>
    <style name="def:floating-point" foreground="#ffffff"/>
    <style name="def:base-n-integer" foreground="#ffffff"/>
    <style name="def:special-constant" foreground="#2d8da1"/>
    <style name="def:constant" foreground="#ffffff"/>
    <style name="def:preprocessor" foreground="#7799a1"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
