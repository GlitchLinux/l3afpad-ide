<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-blink-contrast" name="Blink Contrast" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Blink Contrast (rainglow)</description>

    <style name="text" foreground="#c0ccdb" background="#131719"/>
    <style name="selection" background="#43b5b3"/>
    <style name="cursor" foreground="#ffffff"/>
    <style name="current-line" background="#1a1f22"/>
    <style name="line-numbers" foreground="#c0ccdb" background="#131719"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#4e5c66"/>
    <style name="def:string" foreground="#84c4ce"/>
    <style name="def:keyword" foreground="#d4856a"/>
    <style name="def:statement" foreground="#d4856a"/>
    <style name="def:type" foreground="#5298c4"/>
    <style name="def:function" foreground="#43b5b3"/>
    <style name="def:decimal" foreground="#529ca8"/>
    <style name="def:floating-point" foreground="#529ca8"/>
    <style name="def:base-n-integer" foreground="#529ca8"/>
    <style name="def:special-constant" foreground="#d4856a"/>
    <style name="def:constant" foreground="#529ca8"/>
    <style name="def:preprocessor" foreground="#6f8391"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
