<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-tonic-contrast" name="Tonic Contrast" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Tonic Contrast (rainglow)</description>

    <style name="text" foreground="#eeeeee" background="#111314"/>
    <style name="selection" background="#75a1a4"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#181b1c"/>
    <style name="line-numbers" foreground="#eeeeee" background="#111314"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#4a5356"/>
    <style name="def:string" foreground="#b8cd44"/>
    <style name="def:keyword" foreground="#ef6e44"/>
    <style name="def:statement" foreground="#b8cd44"/>
    <style name="def:type" foreground="#75a1a4"/>
    <style name="def:function" foreground="#fd9f59"/>
    <style name="def:decimal" foreground="#b8cd44"/>
    <style name="def:floating-point" foreground="#b8cd44"/>
    <style name="def:base-n-integer" foreground="#b8cd44"/>
    <style name="def:special-constant" foreground="#b8cd44"/>
    <style name="def:constant" foreground="#b8cd44"/>
    <style name="def:preprocessor" foreground="#6d7b7f"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
