<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-shrek-light" _name="Shrek Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Shrek Light (rainglow)</_description>

    <style name="text" foreground="#222222" background="#ffffff"/>
    <style name="selection" background="#857a5e"/>
    <style name="cursor" foreground="#222222"/>
    <style name="current-line" background="#ffffff"/>
    <style name="line-numbers" foreground="#222222" background="#ffffff"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#aaaaaa"/>
    <style name="def:string" foreground="#81e911"/>
    <style name="def:keyword" foreground="#bfb59b"/>
    <style name="def:statement" foreground="#857a5e"/>
    <style name="def:type" foreground="#b2de62"/>
    <style name="def:function" foreground="#afb2a7"/>
    <style name="def:decimal" foreground="#81e911"/>
    <style name="def:floating-point" foreground="#81e911"/>
    <style name="def:base-n-integer" foreground="#81e911"/>
    <style name="def:special-constant" foreground="#857a5e"/>
    <style name="def:constant" foreground="#81e911"/>
    <style name="def:preprocessor" foreground="#d0d0d0"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
