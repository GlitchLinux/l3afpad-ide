<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-carbonight" name="Carbonight" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Carbonight (rainglow)</description>

    <style name="text" foreground="#b0b0b0" background="#2e2c2b"/>
    <style name="selection" background="#8c8c8c"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#363432"/>
    <style name="line-numbers" foreground="#b0b0b0" background="#2e2c2b"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#423f3d"/>
    <style name="def:string" foreground="#ffffff"/>
    <style name="def:keyword" foreground="#eeeeee"/>
    <style name="def:statement" foreground="#8c8c8c"/>
    <style name="def:type" foreground="#c4c4c4"/>
    <style name="def:function" foreground="#ffffff"/>
    <style name="def:decimal" foreground="#b0b0b0"/>
    <style name="def:floating-point" foreground="#b0b0b0"/>
    <style name="def:base-n-integer" foreground="#b0b0b0"/>
    <style name="def:special-constant" foreground="#8c8c8c"/>
    <style name="def:constant" foreground="#b0b0b0"/>
    <style name="def:preprocessor" foreground="#6a6562"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
