<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-mud" name="Mud" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Mud (rainglow)</description>

    <style name="text" foreground="#ffffff" background="#403635"/>
    <style name="selection" background="#b5db99"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#483d3c"/>
    <style name="line-numbers" foreground="#ffffff" background="#403635"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#c3b8b7"/>
    <style name="def:string" foreground="#b5db99"/>
    <style name="def:keyword" foreground="#ff9787"/>
    <style name="def:statement" foreground="#ff9787"/>
    <style name="def:type" foreground="#e9c865"/>
    <style name="def:function" foreground="#b5db99"/>
    <style name="def:decimal" foreground="#b5db99"/>
    <style name="def:floating-point" foreground="#b5db99"/>
    <style name="def:base-n-integer" foreground="#b5db99"/>
    <style name="def:special-constant" foreground="#ff9787"/>
    <style name="def:constant" foreground="#b5db99"/>
    <style name="def:preprocessor" foreground="#e6e1e1"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
