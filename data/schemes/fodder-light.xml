<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-fodder-light" _name="Fodder Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Fodder Light (rainglow)</_description>

    <style name="text" foreground="#2d4137" background="#cce0d6"/>
    <style name="selection" background="#688e2f"/>
    <style name="cursor" foreground="#222222"/>
    <style name="current-line" background="#d6e6de"/>
    <style name="line-numbers" foreground="#2d4137" background="#cce0d6"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#98aaa1"/>
    <style name="def:string" foreground="#f7a21b"/>
    <style name="def:keyword" foreground="#688e2f"/>
    <style name="def:statement" foreground="#688e2f"/>
    <style name="def:type" foreground="#685b59"/>
    <style name="def:function" foreground="#2d4137"/>
    <style name="def:decimal" foreground="#f7a21b"/>
    <style name="def:floating-point" foreground="#f7a21b"/>
    <style name="def:base-n-integer" foreground="#f7a21b"/>
    <style name="def:special-constant" foreground="#688e2f"/>
    <style name="def:constant" foreground="#f7a21b"/>
    <style name="def:preprocessor" foreground="#c2cdc7"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
