<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-snappy-contrast" _name="Snappy Contrast" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Snappy Contrast (rainglow)</_description>

    <style name="text" foreground="#e3e2e0" background="#0c0c0c"/>
    <style name="selection" background="#f66153"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#141414"/>
    <style name="line-numbers" foreground="#e3e2e0" background="#0c0c0c"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#696969"/>
    <style name="def:string" foreground="#4ea1df"/>
    <style name="def:keyword" foreground="#f66153"/>
    <style name="def:statement" foreground="#f66153"/>
    <style name="def:type" foreground="#4ea1df"/>
    <style name="def:function" foreground="#808dd3"/>
    <style name="def:decimal" foreground="#4ea1df"/>
    <style name="def:floating-point" foreground="#4ea1df"/>
    <style name="def:base-n-integer" foreground="#4ea1df"/>
    <style name="def:special-constant" foreground="#f66153"/>
    <style name="def:constant" foreground="#4ea1df"/>
    <style name="def:preprocessor" foreground="#8f8f8f"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
