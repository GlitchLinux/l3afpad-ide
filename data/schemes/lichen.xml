<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-lichen" name="Lichen" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Lichen (rainglow)</description>

    <style name="text" foreground="#9cadbc" background="#1a252f"/>
    <style name="selection" background="#1a9d6b"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#1f2d39"/>
    <style name="line-numbers" foreground="#9cadbc" background="#1a252f"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#405b75"/>
    <style name="def:string" foreground="#c5d671"/>
    <style name="def:keyword" foreground="#246c82"/>
    <style name="def:statement" foreground="#9ce878"/>
    <style name="def:type" foreground="#249388"/>
    <style name="def:function" foreground="#1a9d6b"/>
    <style name="def:decimal" foreground="#e4f279"/>
    <style name="def:floating-point" foreground="#e4f279"/>
    <style name="def:base-n-integer" foreground="#e4f279"/>
    <style name="def:special-constant" foreground="#9ce878"/>
    <style name="def:constant" foreground="#e4f279"/>
    <style name="def:preprocessor" foreground="#5c81a6"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
