<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-spitfire-light" _name="Spitfire Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Spitfire Light (rainglow)</_description>

    <style name="text" foreground="#24665e" background="#ffffff"/>
    <style name="selection" background="#f75431"/>
    <style name="cursor" foreground="#333333"/>
    <style name="current-line" background="#ffffff"/>
    <style name="line-numbers" foreground="#24665e" background="#ffffff"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#a5b9ba"/>
    <style name="def:string" foreground="#f78d30"/>
    <style name="def:keyword" foreground="#30985b"/>
    <style name="def:statement" foreground="#d6a62f"/>
    <style name="def:type" foreground="#f75431"/>
    <style name="def:function" foreground="#8ec065"/>
    <style name="def:decimal" foreground="#f78d30"/>
    <style name="def:floating-point" foreground="#f78d30"/>
    <style name="def:base-n-integer" foreground="#f78d30"/>
    <style name="def:special-constant" foreground="#d6a62f"/>
    <style name="def:constant" foreground="#f78d30"/>
    <style name="def:preprocessor" foreground="#d0dbdb"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
