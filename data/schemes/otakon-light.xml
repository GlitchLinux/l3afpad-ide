<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-otakon-light" _name="Otakon Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Otakon Light (rainglow)</_description>

    <style name="text" foreground="#514b60" background="#ffffff"/>
    <style name="selection" background="#b1a6ca"/>
    <style name="cursor" foreground="#222222"/>
    <style name="current-line" background="#ffffff"/>
    <style name="line-numbers" foreground="#514b60" background="#ffffff"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#aaaaaa"/>
    <style name="def:string" foreground="#9eb2d9"/>
    <style name="def:keyword" foreground="#a8a9bf"/>
    <style name="def:statement" foreground="#c6b3b9"/>
    <style name="def:type" foreground="#b1a6ca"/>
    <style name="def:function" foreground="#e484b2"/>
    <style name="def:decimal" foreground="#9eb2d9"/>
    <style name="def:floating-point" foreground="#9eb2d9"/>
    <style name="def:base-n-integer" foreground="#9eb2d9"/>
    <style name="def:special-constant" foreground="#c6b3b9"/>
    <style name="def:constant" foreground="#9eb2d9"/>
    <style name="def:preprocessor" foreground="#d0d0d0"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
