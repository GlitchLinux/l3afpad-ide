<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-codecourse-light" name="Codecourse Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Codecourse Light (rainglow)</description>

    <style name="text" foreground="#547f91" background="#ffffff"/>
    <style name="selection" background="#1ea8fc"/>
    <style name="cursor" foreground="#333333"/>
    <style name="current-line" background="#ffffff"/>
    <style name="line-numbers" foreground="#547f91" background="#ffffff"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#9ecee5"/>
    <style name="def:string" foreground="#aaaaaa"/>
    <style name="def:keyword" foreground="#1ea8fc"/>
    <style name="def:statement" foreground="#5dcdfd"/>
    <style name="def:type" foreground="#1ea8fc"/>
    <style name="def:function" foreground="#547f91"/>
    <style name="def:decimal" foreground="#777777"/>
    <style name="def:floating-point" foreground="#777777"/>
    <style name="def:base-n-integer" foreground="#777777"/>
    <style name="def:special-constant" foreground="#5dcdfd"/>
    <style name="def:constant" foreground="#777777"/>
    <style name="def:preprocessor" foreground="#daecf5"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
