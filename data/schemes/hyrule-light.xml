<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-hyrule-light" _name="Hyrule Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Hyrule Light (rainglow)</_description>

    <style name="text" foreground="#2d2c2b" background="#c0d5c1"/>
    <style name="selection" background="#569e16"/>
    <style name="cursor" foreground="#222222"/>
    <style name="current-line" background="#c9dbca"/>
    <style name="line-numbers" foreground="#2d2c2b" background="#c0d5c1"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#93a594"/>
    <style name="def:string" foreground="#ce830d"/>
    <style name="def:keyword" foreground="#68912e"/>
    <style name="def:statement" foreground="#407710"/>
    <style name="def:type" foreground="#b7950c"/>
    <style name="def:function" foreground="#68912e"/>
    <style name="def:decimal" foreground="#f5c504"/>
    <style name="def:floating-point" foreground="#f5c504"/>
    <style name="def:base-n-integer" foreground="#f5c504"/>
    <style name="def:special-constant" foreground="#407710"/>
    <style name="def:constant" foreground="#f5c504"/>
    <style name="def:preprocessor" foreground="#bdc8bd"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
