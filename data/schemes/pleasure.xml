<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-pleasure" _name="Pleasure" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Pleasure (rainglow)</_description>

    <style name="text" foreground="#c0ccdb" background="#32373d"/>
    <style name="selection" background="#a1cbc6"/>
    <style name="cursor" foreground="#ffffff"/>
    <style name="current-line" background="#393f45"/>
    <style name="line-numbers" foreground="#c0ccdb" background="#32373d"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#76818e"/>
    <style name="def:string" foreground="#5685ce"/>
    <style name="def:keyword" foreground="#dd5d7a"/>
    <style name="def:statement" foreground="#dd5d7a"/>
    <style name="def:type" foreground="#a175ba"/>
    <style name="def:function" foreground="#a1cbc6"/>
    <style name="def:decimal" foreground="#a175ba"/>
    <style name="def:floating-point" foreground="#a175ba"/>
    <style name="def:base-n-integer" foreground="#a175ba"/>
    <style name="def:special-constant" foreground="#dd5d7a"/>
    <style name="def:constant" foreground="#a175ba"/>
    <style name="def:preprocessor" foreground="#a0a8b1"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
