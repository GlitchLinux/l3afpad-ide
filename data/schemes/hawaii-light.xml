<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-hawaii-light" name="Hawaii Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Hawaii Light (rainglow)</description>

    <style name="text" foreground="#6d6764" background="#ffffff"/>
    <style name="selection" background="#f75431"/>
    <style name="cursor" foreground="#333333"/>
    <style name="current-line" background="#ffffff"/>
    <style name="line-numbers" foreground="#6d6764" background="#ffffff"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#c4b5ae"/>
    <style name="def:string" foreground="#a2d66b"/>
    <style name="def:keyword" foreground="#e2922f"/>
    <style name="def:statement" foreground="#f75431"/>
    <style name="def:type" foreground="#edbd44"/>
    <style name="def:function" foreground="#52b4d8"/>
    <style name="def:decimal" foreground="#88c448"/>
    <style name="def:floating-point" foreground="#88c448"/>
    <style name="def:base-n-integer" foreground="#88c448"/>
    <style name="def:special-constant" foreground="#f75431"/>
    <style name="def:constant" foreground="#88c448"/>
    <style name="def:preprocessor" foreground="#e4ddda"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
