<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-joker" _name="Joker" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Joker (rainglow)</_description>

    <style name="text" foreground="#c0ccdb" background="#32373d"/>
    <style name="selection" background="#00b27d"/>
    <style name="cursor" foreground="#ffffff"/>
    <style name="current-line" background="#393f45"/>
    <style name="line-numbers" foreground="#c0ccdb" background="#32373d"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#76818e"/>
    <style name="def:string" foreground="#cccccc"/>
    <style name="def:keyword" foreground="#00b27d"/>
    <style name="def:statement" foreground="#9a6fc4"/>
    <style name="def:type" foreground="#00b27d"/>
    <style name="def:function" foreground="#ffffff"/>
    <style name="def:decimal" foreground="#aaaaaa"/>
    <style name="def:floating-point" foreground="#aaaaaa"/>
    <style name="def:base-n-integer" foreground="#aaaaaa"/>
    <style name="def:special-constant" foreground="#9a6fc4"/>
    <style name="def:constant" foreground="#aaaaaa"/>
    <style name="def:preprocessor" foreground="#a0a8b1"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
