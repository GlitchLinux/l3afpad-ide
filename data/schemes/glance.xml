<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-glance" name="Glance" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Glance (rainglow)</description>

    <style name="text" foreground="#ffffff" background="#2d3142"/>
    <style name="selection" background="#ef8354"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#33384b"/>
    <style name="line-numbers" foreground="#ffffff" background="#2d3142"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#726c87"/>
    <style name="def:string" foreground="#83ba7c"/>
    <style name="def:keyword" foreground="#ef8354"/>
    <style name="def:statement" foreground="#6e81a0"/>
    <style name="def:type" foreground="#ef8354"/>
    <style name="def:function" foreground="#ffffff"/>
    <style name="def:decimal" foreground="#7cb8ba"/>
    <style name="def:floating-point" foreground="#7cb8ba"/>
    <style name="def:base-n-integer" foreground="#7cb8ba"/>
    <style name="def:special-constant" foreground="#6e81a0"/>
    <style name="def:constant" foreground="#7cb8ba"/>
    <style name="def:preprocessor" foreground="#9a95aa"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
