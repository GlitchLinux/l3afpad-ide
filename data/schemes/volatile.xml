<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-volatile" name="Volatile" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Volatile (rainglow)</description>

    <style name="text" foreground="#c0ccdb" background="#32373d"/>
    <style name="selection" background="#568769"/>
    <style name="cursor" foreground="#ffffff"/>
    <style name="current-line" background="#393f45"/>
    <style name="line-numbers" foreground="#c0ccdb" background="#32373d"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#76818e"/>
    <style name="def:string" foreground="#dac25c"/>
    <style name="def:keyword" foreground="#ee9c3d"/>
    <style name="def:statement" foreground="#568769"/>
    <style name="def:type" foreground="#ee9c3d"/>
    <style name="def:function" foreground="#ffffff"/>
    <style name="def:decimal" foreground="#db5a51"/>
    <style name="def:floating-point" foreground="#db5a51"/>
    <style name="def:base-n-integer" foreground="#db5a51"/>
    <style name="def:special-constant" foreground="#568769"/>
    <style name="def:constant" foreground="#db5a51"/>
    <style name="def:preprocessor" foreground="#a0a8b1"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
