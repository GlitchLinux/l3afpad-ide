<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-jingle-contrast" name="Jingle Contrast" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Jingle Contrast (rainglow)</description>

    <style name="text" foreground="#c0ccdb" background="#0d1011"/>
    <style name="selection" background="#7ec579"/>
    <style name="cursor" foreground="#ffffff"/>
    <style name="current-line" background="#14181a"/>
    <style name="line-numbers" foreground="#c0ccdb" background="#0d1011"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#4e5c66"/>
    <style name="def:string" foreground="#84c4ce"/>
    <style name="def:keyword" foreground="#e06d5c"/>
    <style name="def:statement" foreground="#7ec579"/>
    <style name="def:type" foreground="#e06d5c"/>
    <style name="def:function" foreground="#98abb7"/>
    <style name="def:decimal" foreground="#e0ad5c"/>
    <style name="def:floating-point" foreground="#e0ad5c"/>
    <style name="def:base-n-integer" foreground="#e0ad5c"/>
    <style name="def:special-constant" foreground="#7ec579"/>
    <style name="def:constant" foreground="#e0ad5c"/>
    <style name="def:preprocessor" foreground="#6f8391"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
