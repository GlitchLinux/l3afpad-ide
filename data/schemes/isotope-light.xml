<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-isotope-light" name="Isotope Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Isotope Light (rainglow)</description>

    <style name="text" foreground="#454955" background="#ffffff"/>
    <style name="selection" background="#b3dd49"/>
    <style name="cursor" foreground="#222222"/>
    <style name="current-line" background="#ffffff"/>
    <style name="line-numbers" foreground="#454955" background="#ffffff"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#7b85a0"/>
    <style name="def:string" foreground="#86baba"/>
    <style name="def:keyword" foreground="#98bc3e"/>
    <style name="def:statement" foreground="#98bc3e"/>
    <style name="def:type" foreground="#72b01d"/>
    <style name="def:function" foreground="#454955"/>
    <style name="def:decimal" foreground="#afd1d1"/>
    <style name="def:floating-point" foreground="#afd1d1"/>
    <style name="def:base-n-integer" foreground="#afd1d1"/>
    <style name="def:special-constant" foreground="#98bc3e"/>
    <style name="def:constant" foreground="#afd1d1"/>
    <style name="def:preprocessor" foreground="#a7aec0"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
