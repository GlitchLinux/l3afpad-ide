<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-freshcut-contrast" _name="FreshCut Contrast" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>FreshCut Contrast (rainglow)</_description>

    <style name="text" foreground="#f8f8f2" background="#000000"/>
    <style name="selection" background="#008097"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#080808"/>
    <style name="line-numbers" foreground="#f8f8f2" background="#000000"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#737b84"/>
    <style name="def:string" foreground="#e9ee00"/>
    <style name="def:keyword" foreground="#c8d7e8"/>
    <style name="def:statement" foreground="#00a8c6"/>
    <style name="def:type" foreground="#4ecdc4"/>
    <style name="def:function" foreground="#aee239"/>
    <style name="def:decimal" foreground="#8fbe00"/>
    <style name="def:floating-point" foreground="#8fbe00"/>
    <style name="def:base-n-integer" foreground="#8fbe00"/>
    <style name="def:special-constant" foreground="#00a8c6"/>
    <style name="def:constant" foreground="#8fbe00"/>
    <style name="def:preprocessor" foreground="#9ba1a8"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
