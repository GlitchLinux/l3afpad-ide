<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-tron" _name="Tron" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Tron (rainglow)</_description>

    <style name="text" foreground="#aec2e0" background="#14191f"/>
    <style name="selection" background="#7a9bc2"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#1a2128"/>
    <style name="line-numbers" foreground="#aec2e0" background="#14191f"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#324357"/>
    <style name="def:string" foreground="#6ee2ff"/>
    <style name="def:keyword" foreground="#748aa6"/>
    <style name="def:statement" foreground="#ffffff"/>
    <style name="def:type" foreground="#267fb5"/>
    <style name="def:function" foreground="#ffffff"/>
    <style name="def:decimal" foreground="#6ee2ff"/>
    <style name="def:floating-point" foreground="#6ee2ff"/>
    <style name="def:base-n-integer" foreground="#6ee2ff"/>
    <style name="def:special-constant" foreground="#ffffff"/>
    <style name="def:constant" foreground="#6ee2ff"/>
    <style name="def:preprocessor" foreground="#4e6888"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
