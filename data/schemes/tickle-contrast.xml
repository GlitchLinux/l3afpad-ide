<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-tickle-contrast" _name="Tickle Contrast" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Tickle Contrast (rainglow)</_description>

    <style name="text" foreground="#c1c1c1" background="#181819"/>
    <style name="selection" background="#ffffff"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#1f1f21"/>
    <style name="line-numbers" foreground="#c1c1c1" background="#181819"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#606063"/>
    <style name="def:string" foreground="#86baba"/>
    <style name="def:keyword" foreground="#85ffc7"/>
    <style name="def:statement" foreground="#40a5a5"/>
    <style name="def:type" foreground="#85ffc7"/>
    <style name="def:function" foreground="#ff8552"/>
    <style name="def:decimal" foreground="#afd1d1"/>
    <style name="def:floating-point" foreground="#afd1d1"/>
    <style name="def:base-n-integer" foreground="#afd1d1"/>
    <style name="def:special-constant" foreground="#40a5a5"/>
    <style name="def:constant" foreground="#afd1d1"/>
    <style name="def:preprocessor" foreground="#86868a"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
