<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-rebellion-light" name="Rebellion Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Rebellion Light (rainglow)</description>

    <style name="text" foreground="#443a27" background="#ede8de"/>
    <style name="selection" background="#fe5f00"/>
    <style name="cursor" foreground="#222222"/>
    <style name="current-line" background="#f2efe8"/>
    <style name="line-numbers" foreground="#443a27" background="#ede8de"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#8e8e70"/>
    <style name="def:string" foreground="#fdb825"/>
    <style name="def:keyword" foreground="#fe5f00"/>
    <style name="def:statement" foreground="#988f2a"/>
    <style name="def:type" foreground="#fe5f00"/>
    <style name="def:function" foreground="#8e7547"/>
    <style name="def:decimal" foreground="#fd9825"/>
    <style name="def:floating-point" foreground="#fd9825"/>
    <style name="def:base-n-integer" foreground="#fd9825"/>
    <style name="def:special-constant" foreground="#988f2a"/>
    <style name="def:constant" foreground="#fd9825"/>
    <style name="def:preprocessor" foreground="#b0b09b"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
