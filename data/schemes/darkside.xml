<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-darkside" _name="Darkside" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Darkside (rainglow)</_description>

    <style name="text" foreground="#bababa" background="#222324"/>
    <style name="selection" background="#ff4e50"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#292b2c"/>
    <style name="line-numbers" foreground="#bababa" background="#222324"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#494b4d"/>
    <style name="def:string" foreground="#f2d42c"/>
    <style name="def:keyword" foreground="#f08d24"/>
    <style name="def:statement" foreground="#e8341c"/>
    <style name="def:type" foreground="#1cc3e8"/>
    <style name="def:function" foreground="#68c244"/>
    <style name="def:decimal" foreground="#8e69c9"/>
    <style name="def:floating-point" foreground="#8e69c9"/>
    <style name="def:base-n-integer" foreground="#8e69c9"/>
    <style name="def:special-constant" foreground="#e8341c"/>
    <style name="def:constant" foreground="#8e69c9"/>
    <style name="def:preprocessor" foreground="#6e7174"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
