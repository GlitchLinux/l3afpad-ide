<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-yule-light" name="Yule Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Yule Light (rainglow)</description>

    <style name="text" foreground="#444444" background="#ffffff"/>
    <style name="selection" background="#d63131"/>
    <style name="cursor" foreground="#222222"/>
    <style name="current-line" background="#ffffff"/>
    <style name="line-numbers" foreground="#444444" background="#ffffff"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#aaaaaa"/>
    <style name="def:string" foreground="#ebb626"/>
    <style name="def:keyword" foreground="#39b81f"/>
    <style name="def:statement" foreground="#d63131"/>
    <style name="def:type" foreground="#39b81f"/>
    <style name="def:function" foreground="#ebb626"/>
    <style name="def:decimal" foreground="#ebb626"/>
    <style name="def:floating-point" foreground="#ebb626"/>
    <style name="def:base-n-integer" foreground="#ebb626"/>
    <style name="def:special-constant" foreground="#d63131"/>
    <style name="def:constant" foreground="#ebb626"/>
    <style name="def:preprocessor" foreground="#d0d0d0"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
