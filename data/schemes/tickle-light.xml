<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-tickle-light" _name="Tickle Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Tickle Light (rainglow)</_description>

    <style name="text" foreground="#444444" background="#ffffff"/>
    <style name="selection" background="#85ffc7"/>
    <style name="cursor" foreground="#222222"/>
    <style name="current-line" background="#ffffff"/>
    <style name="line-numbers" foreground="#444444" background="#ffffff"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#aaaaaa"/>
    <style name="def:string" foreground="#86baba"/>
    <style name="def:keyword" foreground="#65c699"/>
    <style name="def:statement" foreground="#40a5a5"/>
    <style name="def:type" foreground="#65c699"/>
    <style name="def:function" foreground="#ff8552"/>
    <style name="def:decimal" foreground="#afd1d1"/>
    <style name="def:floating-point" foreground="#afd1d1"/>
    <style name="def:base-n-integer" foreground="#afd1d1"/>
    <style name="def:special-constant" foreground="#40a5a5"/>
    <style name="def:constant" foreground="#afd1d1"/>
    <style name="def:preprocessor" foreground="#d0d0d0"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
