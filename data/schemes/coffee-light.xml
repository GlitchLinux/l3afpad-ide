<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-coffee-light" _name="Coffee Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Coffee Light (rainglow)</_description>

    <style name="text" foreground="#282122" background="#f4f2f2"/>
    <style name="selection" background="#0a9f9b"/>
    <style name="cursor" foreground="#222222"/>
    <style name="current-line" background="#fbfafa"/>
    <style name="line-numbers" foreground="#282122" background="#f4f2f2"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#a59d9e"/>
    <style name="def:string" foreground="#a58163"/>
    <style name="def:keyword" foreground="#80b2b0"/>
    <style name="def:statement" foreground="#282122"/>
    <style name="def:type" foreground="#0a9f9b"/>
    <style name="def:function" foreground="#e77757"/>
    <style name="def:decimal" foreground="#cc8f5d"/>
    <style name="def:floating-point" foreground="#cc8f5d"/>
    <style name="def:base-n-integer" foreground="#cc8f5d"/>
    <style name="def:special-constant" foreground="#282122"/>
    <style name="def:constant" foreground="#cc8f5d"/>
    <style name="def:preprocessor" foreground="#cac5c5"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
