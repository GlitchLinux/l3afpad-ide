<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-potpourri-light" name="Potpourri Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Potpourri Light (rainglow)</description>

    <style name="text" foreground="#333333" background="#ffffff"/>
    <style name="selection" background="#ed1153"/>
    <style name="cursor" foreground="#222222"/>
    <style name="current-line" background="#ffffff"/>
    <style name="line-numbers" foreground="#333333" background="#ffffff"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#bbbbbb"/>
    <style name="def:string" foreground="#b866fa"/>
    <style name="def:keyword" foreground="#ed1153"/>
    <style name="def:statement" foreground="#ed1153"/>
    <style name="def:type" foreground="#c491c4"/>
    <style name="def:function" foreground="#b866fa"/>
    <style name="def:decimal" foreground="#c84ff0"/>
    <style name="def:floating-point" foreground="#c84ff0"/>
    <style name="def:base-n-integer" foreground="#c84ff0"/>
    <style name="def:special-constant" foreground="#ed1153"/>
    <style name="def:constant" foreground="#c84ff0"/>
    <style name="def:preprocessor" foreground="#e1e1e1"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
