<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-mellow-light" name="Mellow Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Mellow Light (rainglow)</description>

    <style name="text" foreground="#555555" background="#ffffff"/>
    <style name="selection" background="#f55d79"/>
    <style name="cursor" foreground="#222222"/>
    <style name="current-line" background="#ffffff"/>
    <style name="line-numbers" foreground="#555555" background="#ffffff"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#aaaaaa"/>
    <style name="def:string" foreground="#f8bb39"/>
    <style name="def:keyword" foreground="#f2bc79"/>
    <style name="def:statement" foreground="#1f8181"/>
    <style name="def:type" foreground="#f2bc79"/>
    <style name="def:function" foreground="#f28972"/>
    <style name="def:decimal" foreground="#f8bb39"/>
    <style name="def:floating-point" foreground="#f8bb39"/>
    <style name="def:base-n-integer" foreground="#f8bb39"/>
    <style name="def:special-constant" foreground="#1f8181"/>
    <style name="def:constant" foreground="#f8bb39"/>
    <style name="def:preprocessor" foreground="#d0d0d0"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
