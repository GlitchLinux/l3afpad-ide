<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-stasis-contrast" name="Stasis Contrast" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Stasis Contrast (rainglow)</description>

    <style name="text" foreground="#bbb1c9" background="#0e0d0f"/>
    <style name="selection" background="#fc814a"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#161417"/>
    <style name="line-numbers" foreground="#bbb1c9" background="#0e0d0f"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#655a72"/>
    <style name="def:string" foreground="#e5c71b"/>
    <style name="def:keyword" foreground="#fc814a"/>
    <style name="def:statement" foreground="#7c617c"/>
    <style name="def:type" foreground="#fc814a"/>
    <style name="def:function" foreground="#bfbfbf"/>
    <style name="def:decimal" foreground="#e5c71b"/>
    <style name="def:floating-point" foreground="#e5c71b"/>
    <style name="def:base-n-integer" foreground="#e5c71b"/>
    <style name="def:special-constant" foreground="#7c617c"/>
    <style name="def:constant" foreground="#e5c71b"/>
    <style name="def:preprocessor" foreground="#8b7f9a"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
