<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-mintchoc-light" name="Mintchoc Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Mintchoc Light (rainglow)</description>

    <style name="text" foreground="#444444" background="#ffffff"/>
    <style name="selection" background="#008d62"/>
    <style name="cursor" foreground="#222222"/>
    <style name="current-line" background="#ffffff"/>
    <style name="line-numbers" foreground="#444444" background="#ffffff"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#b29b8d"/>
    <style name="def:string" foreground="#00e08c"/>
    <style name="def:keyword" foreground="#9d8262"/>
    <style name="def:statement" foreground="#008d62"/>
    <style name="def:type" foreground="#9d8262"/>
    <style name="def:function" foreground="#00e08c"/>
    <style name="def:decimal" foreground="#00e08c"/>
    <style name="def:floating-point" foreground="#00e08c"/>
    <style name="def:base-n-integer" foreground="#00e08c"/>
    <style name="def:special-constant" foreground="#008d62"/>
    <style name="def:constant" foreground="#00e08c"/>
    <style name="def:preprocessor" foreground="#d1c3bb"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
