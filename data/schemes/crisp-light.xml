<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-crisp-light" name="Crisp Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Crisp Light (rainglow)</description>

    <style name="text" foreground="#221a22" background="#ffffff"/>
    <style name="selection" background="#fc6a0f"/>
    <style name="cursor" foreground="#222222"/>
    <style name="current-line" background="#ffffff"/>
    <style name="line-numbers" foreground="#221a22" background="#ffffff"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#c6a7c6"/>
    <style name="def:string" foreground="#fc9a0f"/>
    <style name="def:keyword" foreground="#fc6a0f"/>
    <style name="def:statement" foreground="#765478"/>
    <style name="def:type" foreground="#99769b"/>
    <style name="def:function" foreground="#fc6a0f"/>
    <style name="def:decimal" foreground="#fc9a0f"/>
    <style name="def:floating-point" foreground="#fc9a0f"/>
    <style name="def:base-n-integer" foreground="#fc9a0f"/>
    <style name="def:special-constant" foreground="#765478"/>
    <style name="def:constant" foreground="#fc9a0f"/>
    <style name="def:preprocessor" foreground="#e4d5e4"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
