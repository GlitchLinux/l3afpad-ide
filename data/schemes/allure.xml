<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-allure" _name="Allure" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Allure (rainglow)</_description>

    <style name="text" foreground="#c0ccdb" background="#32373d"/>
    <style name="selection" background="#5da892"/>
    <style name="cursor" foreground="#ffffff"/>
    <style name="current-line" background="#393f45"/>
    <style name="line-numbers" foreground="#c0ccdb" background="#32373d"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#76818e"/>
    <style name="def:string" foreground="#cec86f"/>
    <style name="def:keyword" foreground="#5da892"/>
    <style name="def:statement" foreground="#e4d294"/>
    <style name="def:type" foreground="#5da892"/>
    <style name="def:function" foreground="#ffffff"/>
    <style name="def:decimal" foreground="#cea36f"/>
    <style name="def:floating-point" foreground="#cea36f"/>
    <style name="def:base-n-integer" foreground="#cea36f"/>
    <style name="def:special-constant" foreground="#e4d294"/>
    <style name="def:constant" foreground="#cea36f"/>
    <style name="def:preprocessor" foreground="#a0a8b1"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
