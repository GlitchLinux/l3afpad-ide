<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-prime-light" _name="Prime Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Prime Light (rainglow)</_description>

    <style name="text" foreground="#3d3d5b" background="#ffffff"/>
    <style name="selection" background="#ee4266"/>
    <style name="cursor" foreground="#333333"/>
    <style name="current-line" background="#ffffff"/>
    <style name="line-numbers" foreground="#3d3d5b" background="#ffffff"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#a7a7e2"/>
    <style name="def:string" foreground="#a2d66b"/>
    <style name="def:keyword" foreground="#727c6f"/>
    <style name="def:statement" foreground="#ee4266"/>
    <style name="def:type" foreground="#9d50ba"/>
    <style name="def:function" foreground="#ffd23f"/>
    <style name="def:decimal" foreground="#88c448"/>
    <style name="def:floating-point" foreground="#88c448"/>
    <style name="def:base-n-integer" foreground="#88c448"/>
    <style name="def:special-constant" foreground="#ee4266"/>
    <style name="def:constant" foreground="#88c448"/>
    <style name="def:preprocessor" foreground="#e1e1f5"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
