<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-chocolate" _name="Chocolate" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Chocolate (rainglow)</_description>

    <style name="text" foreground="#ffffff" background="#261b0e"/>
    <style name="selection" background="#8b6e46"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#312312"/>
    <style name="line-numbers" foreground="#ffffff" background="#261b0e"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#8e6239"/>
    <style name="def:string" foreground="#f7a21b"/>
    <style name="def:keyword" foreground="#b99768"/>
    <style name="def:statement" foreground="#ccb697"/>
    <style name="def:type" foreground="#8b6e46"/>
    <style name="def:function" foreground="#e2cdb0"/>
    <style name="def:decimal" foreground="#f7a21b"/>
    <style name="def:floating-point" foreground="#f7a21b"/>
    <style name="def:base-n-integer" foreground="#f7a21b"/>
    <style name="def:special-constant" foreground="#ccb697"/>
    <style name="def:constant" foreground="#f7a21b"/>
    <style name="def:preprocessor" foreground="#bc8858"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
