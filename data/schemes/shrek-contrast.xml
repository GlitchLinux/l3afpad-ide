<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-shrek-contrast" _name="Shrek Contrast" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Shrek Contrast (rainglow)</_description>

    <style name="text" foreground="#ffffff" background="#000000"/>
    <style name="selection" background="#857a5e"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#080808"/>
    <style name="line-numbers" foreground="#ffffff" background="#000000"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#555555"/>
    <style name="def:string" foreground="#81e911"/>
    <style name="def:keyword" foreground="#bfb59b"/>
    <style name="def:statement" foreground="#857a5e"/>
    <style name="def:type" foreground="#b2de62"/>
    <style name="def:function" foreground="#f0f2eb"/>
    <style name="def:decimal" foreground="#81e911"/>
    <style name="def:floating-point" foreground="#81e911"/>
    <style name="def:base-n-integer" foreground="#81e911"/>
    <style name="def:special-constant" foreground="#857a5e"/>
    <style name="def:constant" foreground="#81e911"/>
    <style name="def:preprocessor" foreground="#7b7b7b"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
