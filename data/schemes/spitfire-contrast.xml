<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-spitfire-contrast" _name="Spitfire Contrast" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Spitfire Contrast (rainglow)</_description>

    <style name="text" foreground="#bad3d0" background="#091c19"/>
    <style name="selection" background="#f75431"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#0d2823"/>
    <style name="line-numbers" foreground="#bad3d0" background="#091c19"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#2d7a7f"/>
    <style name="def:string" foreground="#f78d30"/>
    <style name="def:keyword" foreground="#30985b"/>
    <style name="def:statement" foreground="#facc54"/>
    <style name="def:type" foreground="#f75431"/>
    <style name="def:function" foreground="#8ec065"/>
    <style name="def:decimal" foreground="#f78d30"/>
    <style name="def:floating-point" foreground="#f78d30"/>
    <style name="def:base-n-integer" foreground="#f78d30"/>
    <style name="def:special-constant" foreground="#facc54"/>
    <style name="def:constant" foreground="#f78d30"/>
    <style name="def:preprocessor" foreground="#41b0b7"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
