<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-iceberg-light" _name="Iceberg Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Iceberg Light (rainglow)</_description>

    <style name="text" foreground="#323b3d" background="#bdd6db"/>
    <style name="selection" background="#2d8da1"/>
    <style name="cursor" foreground="#222222"/>
    <style name="current-line" background="#c7dce0"/>
    <style name="line-numbers" foreground="#323b3d" background="#bdd6db"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#7e9296"/>
    <style name="def:string" foreground="#2d8da1"/>
    <style name="def:keyword" foreground="#7ea3af"/>
    <style name="def:statement" foreground="#2d8da1"/>
    <style name="def:type" foreground="#499fbc"/>
    <style name="def:function" foreground="#323b3d"/>
    <style name="def:decimal" foreground="#2d8da1"/>
    <style name="def:floating-point" foreground="#2d8da1"/>
    <style name="def:base-n-integer" foreground="#2d8da1"/>
    <style name="def:special-constant" foreground="#2d8da1"/>
    <style name="def:constant" foreground="#2d8da1"/>
    <style name="def:preprocessor" foreground="#a8b6b8"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
