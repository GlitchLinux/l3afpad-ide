<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-tweed-contrast" _name="Tweed Contrast" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Tweed Contrast (rainglow)</_description>

    <style name="text" foreground="#ffffff" background="#1e2026"/>
    <style name="selection" background="#d3643b"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#25272f"/>
    <style name="line-numbers" foreground="#ffffff" background="#1e2026"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#4d5363"/>
    <style name="def:string" foreground="#e7a84b"/>
    <style name="def:keyword" foreground="#e2975f"/>
    <style name="def:statement" foreground="#5e9989"/>
    <style name="def:type" foreground="#777f93"/>
    <style name="def:function" foreground="#cab696"/>
    <style name="def:decimal" foreground="#e7a84b"/>
    <style name="def:floating-point" foreground="#e7a84b"/>
    <style name="def:base-n-integer" foreground="#e7a84b"/>
    <style name="def:special-constant" foreground="#5e9989"/>
    <style name="def:constant" foreground="#e7a84b"/>
    <style name="def:preprocessor" foreground="#6e778e"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
