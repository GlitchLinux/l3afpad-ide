<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-morass-light" name="Morass Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Morass Light (rainglow)</description>

    <style name="text" foreground="#444444" background="#ffffff"/>
    <style name="selection" background="#68875a"/>
    <style name="cursor" foreground="#222222"/>
    <style name="current-line" background="#ffffff"/>
    <style name="line-numbers" foreground="#444444" background="#ffffff"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#8fa89b"/>
    <style name="def:string" foreground="#f8bb39"/>
    <style name="def:keyword" foreground="#80a396"/>
    <style name="def:statement" foreground="#68875a"/>
    <style name="def:type" foreground="#cec040"/>
    <style name="def:function" foreground="#afb54c"/>
    <style name="def:decimal" foreground="#f8bb39"/>
    <style name="def:floating-point" foreground="#f8bb39"/>
    <style name="def:base-n-integer" foreground="#f8bb39"/>
    <style name="def:special-constant" foreground="#68875a"/>
    <style name="def:constant" foreground="#f8bb39"/>
    <style name="def:preprocessor" foreground="#bac9c1"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
