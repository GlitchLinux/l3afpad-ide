<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-dare-light" name="Dare Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Dare Light (rainglow)</description>

    <style name="text" foreground="#6e7a87" background="#ffffff"/>
    <style name="selection" background="#5da892"/>
    <style name="cursor" foreground="#333333"/>
    <style name="current-line" background="#ffffff"/>
    <style name="line-numbers" foreground="#6e7a87" background="#ffffff"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#b3bcc6"/>
    <style name="def:string" foreground="#a5bab3"/>
    <style name="def:keyword" foreground="#3a8881"/>
    <style name="def:statement" foreground="#d15736"/>
    <style name="def:type" foreground="#3a8881"/>
    <style name="def:function" foreground="#6e7a87"/>
    <style name="def:decimal" foreground="#a5bab3"/>
    <style name="def:floating-point" foreground="#a5bab3"/>
    <style name="def:base-n-integer" foreground="#a5bab3"/>
    <style name="def:special-constant" foreground="#d15736"/>
    <style name="def:constant" foreground="#a5bab3"/>
    <style name="def:preprocessor" foreground="#dfe3e7"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
