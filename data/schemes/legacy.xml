<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-legacy" _name="Legacy" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Legacy (rainglow)</_description>

    <style name="text" foreground="#aec2e0" background="#212933"/>
    <style name="selection" background="#ff410d"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#27303c"/>
    <style name="line-numbers" foreground="#aec2e0" background="#212933"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#425972"/>
    <style name="def:string" foreground="#ff410d"/>
    <style name="def:keyword" foreground="#748aa6"/>
    <style name="def:statement" foreground="#ffffff"/>
    <style name="def:type" foreground="#267fb5"/>
    <style name="def:function" foreground="#ffb20d"/>
    <style name="def:decimal" foreground="#c7f026"/>
    <style name="def:floating-point" foreground="#c7f026"/>
    <style name="def:base-n-integer" foreground="#c7f026"/>
    <style name="def:special-constant" foreground="#ffffff"/>
    <style name="def:constant" foreground="#c7f026"/>
    <style name="def:preprocessor" foreground="#5e7fa2"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
