<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-kiwi-contrast" name="Kiwi Contrast" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Kiwi Contrast (rainglow)</description>

    <style name="text" foreground="#edebe6" background="#0c0f0e"/>
    <style name="selection" background="#0b6d5c"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#131716"/>
    <style name="line-numbers" foreground="#edebe6" background="#0c0f0e"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#354341"/>
    <style name="def:string" foreground="#a1e6c1"/>
    <style name="def:keyword" foreground="#229986"/>
    <style name="def:statement" foreground="#95c72a"/>
    <style name="def:type" foreground="#229986"/>
    <style name="def:function" foreground="#0b6d5c"/>
    <style name="def:decimal" foreground="#a1e6c1"/>
    <style name="def:floating-point" foreground="#a1e6c1"/>
    <style name="def:base-n-integer" foreground="#a1e6c1"/>
    <style name="def:special-constant" foreground="#95c72a"/>
    <style name="def:constant" foreground="#a1e6c1"/>
    <style name="def:preprocessor" foreground="#576e6a"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
