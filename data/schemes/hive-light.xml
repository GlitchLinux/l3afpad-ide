<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-hive-light" _name="Hive Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Hive Light (rainglow)</_description>

    <style name="text" foreground="#2d3142" background="#ffffff"/>
    <style name="selection" background="#7cb8ba"/>
    <style name="cursor" foreground="#222222"/>
    <style name="current-line" background="#ffffff"/>
    <style name="line-numbers" foreground="#2d3142" background="#ffffff"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#9b9fb2"/>
    <style name="def:string" foreground="#dbc583"/>
    <style name="def:keyword" foreground="#7cb8ba"/>
    <style name="def:statement" foreground="#6e81a0"/>
    <style name="def:type" foreground="#7cb8ba"/>
    <style name="def:function" foreground="#2d3142"/>
    <style name="def:decimal" foreground="#83ba7c"/>
    <style name="def:floating-point" foreground="#83ba7c"/>
    <style name="def:base-n-integer" foreground="#83ba7c"/>
    <style name="def:special-constant" foreground="#6e81a0"/>
    <style name="def:constant" foreground="#83ba7c"/>
    <style name="def:preprocessor" foreground="#c6c8d3"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
