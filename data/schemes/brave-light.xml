<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-brave-light" _name="Brave Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Brave Light (rainglow)</_description>

    <style name="text" foreground="#2c2d2d" background="#f7f9f9"/>
    <style name="selection" background="#908bbc"/>
    <style name="cursor" foreground="#222222"/>
    <style name="current-line" background="#ffffff"/>
    <style name="line-numbers" foreground="#2c2d2d" background="#f7f9f9"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#ccc9e0"/>
    <style name="def:string" foreground="#63a5a5"/>
    <style name="def:keyword" foreground="#abaab7"/>
    <style name="def:statement" foreground="#7873a0"/>
    <style name="def:type" foreground="#bc4331"/>
    <style name="def:function" foreground="#6e909e"/>
    <style name="def:decimal" foreground="#4eadad"/>
    <style name="def:floating-point" foreground="#4eadad"/>
    <style name="def:base-n-integer" foreground="#4eadad"/>
    <style name="def:special-constant" foreground="#7873a0"/>
    <style name="def:constant" foreground="#4eadad"/>
    <style name="def:preprocessor" foreground="#fafafc"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
