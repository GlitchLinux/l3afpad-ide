<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-downpour-light" _name="Downpour Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Downpour Light (rainglow)</_description>

    <style name="text" foreground="#2c323d" background="#d6dbdb"/>
    <style name="selection" background="#908bbc"/>
    <style name="cursor" foreground="#222222"/>
    <style name="current-line" background="#dee2e2"/>
    <style name="line-numbers" foreground="#2c323d" background="#d6dbdb"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#9da5a5"/>
    <style name="def:string" foreground="#63a5a5"/>
    <style name="def:keyword" foreground="#787782"/>
    <style name="def:statement" foreground="#736f99"/>
    <style name="def:type" foreground="#bc4331"/>
    <style name="def:function" foreground="#698996"/>
    <style name="def:decimal" foreground="#4eadad"/>
    <style name="def:floating-point" foreground="#4eadad"/>
    <style name="def:base-n-integer" foreground="#4eadad"/>
    <style name="def:special-constant" foreground="#736f99"/>
    <style name="def:constant" foreground="#4eadad"/>
    <style name="def:preprocessor" foreground="#c5caca"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
