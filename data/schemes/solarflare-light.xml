<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-solarflare-light" name="Solarflare Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Solarflare Light (rainglow)</description>

    <style name="text" foreground="#222222" background="#ffffff"/>
    <style name="selection" background="#ff4e50"/>
    <style name="cursor" foreground="#222222"/>
    <style name="current-line" background="#ffffff"/>
    <style name="line-numbers" foreground="#222222" background="#ffffff"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#999999"/>
    <style name="def:string" foreground="#c6bb15"/>
    <style name="def:keyword" foreground="#ff4e50"/>
    <style name="def:statement" foreground="#ff4e50"/>
    <style name="def:type" foreground="#d87627"/>
    <style name="def:function" foreground="#c6bb15"/>
    <style name="def:decimal" foreground="#ff4e50"/>
    <style name="def:floating-point" foreground="#ff4e50"/>
    <style name="def:base-n-integer" foreground="#ff4e50"/>
    <style name="def:special-constant" foreground="#ff4e50"/>
    <style name="def:constant" foreground="#ff4e50"/>
    <style name="def:preprocessor" foreground="#bfbfbf"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
