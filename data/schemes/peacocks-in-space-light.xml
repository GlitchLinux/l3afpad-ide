<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-peacocks-in-space-light" name="Peacocks In Space Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Peacocks In Space Light (rainglow)</description>

    <style name="text" foreground="#2b303b" background="#dee3ec"/>
    <style name="selection" background="#26a6a6"/>
    <style name="cursor" foreground="#2b303b"/>
    <style name="current-line" background="#e8ebf2"/>
    <style name="line-numbers" foreground="#2b303b" background="#dee3ec"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#6e7a94"/>
    <style name="def:string" foreground="#a6b73a"/>
    <style name="def:keyword" foreground="#26a6a6"/>
    <style name="def:statement" foreground="#ff5d38"/>
    <style name="def:type" foreground="#26a6a6"/>
    <style name="def:function" foreground="#a6b73a"/>
    <style name="def:decimal" foreground="#a6b73a"/>
    <style name="def:floating-point" foreground="#a6b73a"/>
    <style name="def:base-n-integer" foreground="#a6b73a"/>
    <style name="def:special-constant" foreground="#ff5d38"/>
    <style name="def:constant" foreground="#a6b73a"/>
    <style name="def:preprocessor" foreground="#9aa2b4"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
