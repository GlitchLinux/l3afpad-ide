<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-sourlick-light" name="Sourlick Light" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Sourlick Light (rainglow)</description>

    <style name="text" foreground="#333333" background="#ffffff"/>
    <style name="selection" background="#518f0d"/>
    <style name="cursor" foreground="#222222"/>
    <style name="current-line" background="#ffffff"/>
    <style name="line-numbers" foreground="#333333" background="#ffffff"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#888888"/>
    <style name="def:string" foreground="#b7ce25"/>
    <style name="def:keyword" foreground="#afc425"/>
    <style name="def:statement" foreground="#6ba05d"/>
    <style name="def:type" foreground="#bfc431"/>
    <style name="def:function" foreground="#94c117"/>
    <style name="def:decimal" foreground="#fc580c"/>
    <style name="def:floating-point" foreground="#fc580c"/>
    <style name="def:base-n-integer" foreground="#fc580c"/>
    <style name="def:special-constant" foreground="#6ba05d"/>
    <style name="def:constant" foreground="#fc580c"/>
    <style name="def:preprocessor" foreground="#aeaeae"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
