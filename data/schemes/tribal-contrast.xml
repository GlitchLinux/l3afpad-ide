<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-tribal-contrast" name="Tribal Contrast" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <description>Tribal Contrast (rainglow)</description>

    <style name="text" foreground="#ffffff" background="#19191d"/>
    <style name="selection" background="#47959a"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#202025"/>
    <style name="line-numbers" foreground="#ffffff" background="#19191d"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#4a4a54"/>
    <style name="def:string" foreground="#64aeb3"/>
    <style name="def:keyword" foreground="#5f5582"/>
    <style name="def:statement" foreground="#5f5582"/>
    <style name="def:type" foreground="#c43535"/>
    <style name="def:function" foreground="#e0ddeb"/>
    <style name="def:decimal" foreground="#64aeb3"/>
    <style name="def:floating-point" foreground="#64aeb3"/>
    <style name="def:base-n-integer" foreground="#64aeb3"/>
    <style name="def:special-constant" foreground="#5f5582"/>
    <style name="def:constant" foreground="#64aeb3"/>
    <style name="def:preprocessor" foreground="#6e6e7d"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
