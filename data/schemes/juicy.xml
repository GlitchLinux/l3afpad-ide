<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-juicy" _name="Juicy" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Juicy (rainglow)</_description>

    <style name="text" foreground="#e3e2e0" background="#222222"/>
    <style name="selection" background="#ff4e50"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#2a2a2a"/>
    <style name="line-numbers" foreground="#e3e2e0" background="#222222"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#777777"/>
    <style name="def:string" foreground="#3bc7b8"/>
    <style name="def:keyword" foreground="#edb92e"/>
    <style name="def:statement" foreground="#3bc7b8"/>
    <style name="def:type" foreground="#ff4e50"/>
    <style name="def:function" foreground="#c3cb4c"/>
    <style name="def:decimal" foreground="#ce1836"/>
    <style name="def:floating-point" foreground="#ce1836"/>
    <style name="def:base-n-integer" foreground="#ce1836"/>
    <style name="def:special-constant" foreground="#3bc7b8"/>
    <style name="def:constant" foreground="#ce1836"/>
    <style name="def:preprocessor" foreground="#9d9d9d"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
