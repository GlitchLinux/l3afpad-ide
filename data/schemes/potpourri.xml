<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="rainglow-potpourri" _name="Potpourri" version="1.0">
  <author>rainglow (Dayle Rees), converted for l3afpad</author>
  <_description>Potpourri (rainglow)</_description>

    <style name="text" foreground="#f8f8f2" background="#2e2b2c"/>
    <style name="selection" background="#ed1153"/>
    <style name="cursor" foreground="#f8f8f0"/>
    <style name="current-line" background="#363234"/>
    <style name="line-numbers" foreground="#f8f8f2" background="#2e2b2c"/>
    <style name="bracket-match" bold="true"/>

    <style name="def:comment" foreground="#696363"/>
    <style name="def:string" foreground="#b866fa"/>
    <style name="def:keyword" foreground="#ed1153"/>
    <style name="def:statement" foreground="#ed1153"/>
    <style name="def:type" foreground="#c491c4"/>
    <style name="def:function" foreground="#b866fa"/>
    <style name="def:decimal" foreground="#c84ff0"/>
    <style name="def:floating-point" foreground="#c84ff0"/>
    <style name="def:base-n-integer" foreground="#c84ff0"/>
    <style name="def:special-constant" foreground="#ed1153"/>
    <style name="def:constant" foreground="#c84ff0"/>
    <style name="def:preprocessor" foreground="#908989"/>
    <style name="def:error" foreground="#cf433e"/>
</style-scheme>
